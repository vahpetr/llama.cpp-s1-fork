#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_basic : enable
#if USE_SUBGROUP_CLUSTERED
#extension GL_KHR_shader_subgroup_clustered : enable
#endif
#if USE_SUBGROUP_ADD
#extension GL_KHR_shader_subgroup_arithmetic : enable
#endif

// Caller guarantees valid spec constants: S_V % COLS_PER_WG == 0 and S_V % LANES_PER_COLUMN == 0,
// so no bounds checking is needed.
layout(constant_id = 0) const uint S_V = 128;
layout(constant_id = 1) const uint KDA = 0;
layout(constant_id = 2) const uint SUBGROUP_SIZE = 32;
layout(constant_id = 3) const uint LANES_PER_COLUMN = 32;

const uint COLS_PER_WG = SUBGROUP_SIZE / LANES_PER_COLUMN;
const uint ROWS_PER_LANE = S_V / LANES_PER_COLUMN;

layout(local_size_x_id = 2, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint H;
    uint n_tokens;
    uint n_seqs;
    uint sq1, sq2, sq3;
    uint sv1, sv2, sv3;
    uint sb1, sb2, sb3;
    uint neq1, rq3;
    float scale;
    uint K;
    // state snapshot destination (binding 7): element offset of slot 0 / seq 0 / head 0, then
    //   slot k of sequence n, head h at  so_off + k*so2 + n*so1 + h*S_V*S_V
    // packed (legacy) output: binding 7 aliases DstBuf, so_off = attn size, so1 = H*S_V*S_V, so2 = so1*n_seqs
    // direct store:           binding 7 is the destination view, so_off = its misalignment in floats
    uint so_off, so1, so2;
#if GDN_REPLAY
    // commit by replay (ggml_gated_delta_net_set_replay): W rows per stash half, row = floats per token row
    uint st_w, st_row;
#endif
};

layout(binding = 0) readonly  buffer QBuf     { FLOAT_TYPE data_q[];     };
layout(binding = 1) readonly  buffer KBuf     { FLOAT_TYPE data_k[];     };
layout(binding = 2) readonly  buffer VBuf     { FLOAT_TYPE data_v[];     };
layout(binding = 3) readonly  buffer GBuf     { FLOAT_TYPE data_g[];     };
layout(binding = 4) readonly  buffer BetaBuf  { FLOAT_TYPE data_beta[];  };
layout(binding = 5) readonly  buffer StateBuf { FLOAT_TYPE data_state[]; };
layout(binding = 6)           buffer DstBuf     { FLOAT_TYPE data_dst[];       };
layout(binding = 7)           buffer DstStateBuf { FLOAT_TYPE data_dst_state[]; };
#if GDN_REPLAY
// stash: token rows k [S_V*neq1], v [S_V*H], g [H or S_V*H], beta [H]; (slot c, half h) = plane c*2 + h of st_w rows
layout(binding = 8)           buffer StashBuf    { FLOAT_TYPE data_stash[];     };
// per sequence { n_prefix, read_half, n_defer, slot }, see ggml.h
layout(binding = 9) readonly  buffer CtlBuf      { int        data_ctl[];       };
#endif

#if !USE_SUBGROUP_ADD && !USE_SUBGROUP_CLUSTERED
shared FLOAT_TYPE temp[SUBGROUP_SIZE];

// This does a reduction across groups of LANES_PER_COLUMN
FLOAT_TYPE reduce_add_shmem(FLOAT_TYPE partial) {
    const uint lane = gl_SubgroupInvocationID;
    temp[lane] = partial;
    barrier();
    [[unroll]] for (uint s = LANES_PER_COLUMN / 2u; s > 0; s >>= 1u) {
        FLOAT_TYPE other = temp[lane ^ s];
        barrier();
        temp[lane] += other;
        barrier();
    }
    const FLOAT_TYPE result = temp[lane];
    barrier();
    return result;
}
#endif

// clusterSize for subgroupClusteredAdd must be a compile-time constant; branch on spec constant
FLOAT_TYPE reduce_partial(FLOAT_TYPE partial) {
    switch (LANES_PER_COLUMN) {
        case 1u:
            return partial;
#if USE_SUBGROUP_CLUSTERED
        // Workaround for GLSL requiring a literal constant for the cluster size.
        // The branches should all fold away.
        case 2u:
            return subgroupClusteredAdd(partial, 2u);
        case 4u:
            return subgroupClusteredAdd(partial, 4u);
        case 8u:
            return subgroupClusteredAdd(partial, 8u);
        case 16u:
            return subgroupClusteredAdd(partial, 16u);
        case 32u:
            return subgroupClusteredAdd(partial, 32u);
        case 64u:
            return subgroupClusteredAdd(partial, 64u);
#endif
        default:
#if USE_SUBGROUP_ADD
            return subgroupAdd(partial);
#else
            return reduce_add_shmem(partial);
#endif
    }
}

void main() {
    const uint head_id = gl_WorkGroupID.x;
    const uint seq_id = gl_WorkGroupID.y;
    const uint lane = gl_SubgroupInvocationID % LANES_PER_COLUMN;
    const uint col = gl_WorkGroupID.z * COLS_PER_WG + (gl_SubgroupInvocationID / LANES_PER_COLUMN);

    const uint iq1 = head_id % neq1;
    const uint iq3 = seq_id / rq3;

    const uint state_size = S_V * S_V;
    // input state holds s0 only [S_v, S_v, H, n_seqs]: per-seq stride is H*D.
    const uint state_in_base  = (seq_id * H + head_id) * state_size;
    // output state: the (seq, head) offset inside a snapshot slot; the slot stride is a push constant
    const uint state_out_base = so_off + seq_id * so1 + head_id * state_size;

    FLOAT_TYPE s_shard[ROWS_PER_LANE];
    [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
        s_shard[r] = FLOAT_TYPE(data_state[state_in_base + col * S_V + r * LANES_PER_COLUMN + lane]);
    }

    // snapshot slot mapping: slot 0 = most recent state, slot s = s tokens back.
    // When n_tokens < K, only slots 0..n_tokens-1 are written; older slots are caller-owned.

    uint attn_off = (seq_id * n_tokens * H + head_id) * S_V;

#if GDN_REPLAY
    // one loop over the replayed prefix (t < 0, inputs from the stash) and the window (t >= 0, the op's inputs): the
    //   state update below is the same code for both. The state written to the cache is the one after token tc
    const int  n_prefix  = data_ctl[seq_id * 4 + 0];
    const uint read_half = uint(data_ctl[seq_id * 4 + 1]);
    const int  n_defer   = data_ctl[seq_id * 4 + 2];
    const uint slot      = uint(data_ctl[seq_id * 4 + 3]);
    const int  tc        = n_defer < 0 ? -1 : int(n_tokens) - 1 - n_defer; // n_defer < 0: commit only, no window
    const int  t_end     = n_defer < 0 ? 0 : int(n_tokens);
    const uint st_v      = S_V * neq1;
    const uint st_g      = st_v + S_V * H;
    const uint st_b      = st_g + (KDA == 0 ? 1u : S_V) * H;
    const uint st_rd     = ((slot * 2u + read_half) * st_w) * st_row;
    const uint st_wr     = ((slot * 2u + (1u - read_half)) * st_w) * st_row;
    const uint state_dst = state_out_base;

    if (tc == -1 && n_prefix == 0) {
        [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
            data_dst_state[state_dst + col * S_V + r * LANES_PER_COLUMN + lane] = s_shard[r];
        }
    }

    for (int ti = -n_prefix; ti < t_end; ti++) {
        FLOAT_TYPE k_reg[ROWS_PER_LANE];
        FLOAT_TYPE q_reg[ROWS_PER_LANE];
        FLOAT_TYPE g_raw[ROWS_PER_LANE];
        FLOAT_TYPE v_val;
        FLOAT_TYPE beta_val;
        if (ti < 0) {
            const uint row = st_rd + uint(ti + n_prefix) * st_row;
            beta_val = data_stash[row + st_b + head_id];
            [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                const uint i = r * LANES_PER_COLUMN + lane;
                k_reg[r] = data_stash[row + iq1 * S_V + i];
                q_reg[r] = FLOAT_TYPE(0);
                g_raw[r] = KDA == 0 ? data_stash[row + st_g + head_id] : data_stash[row + st_g + head_id * S_V + i];
            }
            v_val = data_stash[row + st_v + head_id * S_V + col];
        } else {
            const uint t = uint(ti);
            const uint q_off = iq3 * sq3 + t * sq2 + iq1 * sq1;
            const uint k_off = q_off;
            const uint v_off = seq_id * sv3 + t * sv2 + head_id * sv1;
            const uint gb_off = seq_id * sb3 + t * sb2 + head_id * sb1;
            beta_val = FLOAT_TYPE(data_beta[gb_off]);
            [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                const uint i = r * LANES_PER_COLUMN + lane;
                k_reg[r] = FLOAT_TYPE(data_k[k_off + i]);
                q_reg[r] = FLOAT_TYPE(data_q[q_off + i]);
                g_raw[r] = KDA == 0 ? FLOAT_TYPE(data_g[gb_off]) : FLOAT_TYPE(data_g[gb_off * S_V + i]);
            }
            v_val = FLOAT_TYPE(data_v[v_off + col]);
        }

        FLOAT_TYPE g_exp[ROWS_PER_LANE];
        [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
            g_exp[r] = exp(g_raw[r]);
        }
#else
    for (uint t = 0; t < n_tokens; t++) {
        const uint q_off = iq3 * sq3 + t * sq2 + iq1 * sq1;
        const uint k_off = q_off;
        const uint v_off = seq_id * sv3 + t * sv2 + head_id * sv1;
        const uint gb_off = seq_id * sb3 + t * sb2 + head_id * sb1;
        const FLOAT_TYPE beta_val = FLOAT_TYPE(data_beta[gb_off]);

        FLOAT_TYPE k_reg[ROWS_PER_LANE];
        FLOAT_TYPE q_reg[ROWS_PER_LANE];
        [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
            const uint i = r * LANES_PER_COLUMN + lane;
            k_reg[r] = FLOAT_TYPE(data_k[k_off + i]);
            q_reg[r] = FLOAT_TYPE(data_q[q_off + i]);
        }

        FLOAT_TYPE g_exp[ROWS_PER_LANE];
        if (KDA == 0) {
            const FLOAT_TYPE g_val = exp(FLOAT_TYPE(data_g[gb_off]));
            [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                g_exp[r] = g_val;
            }
        } else {
            const uint g_base = gb_off * S_V;
            [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                const uint i = r * LANES_PER_COLUMN + lane;
                g_exp[r] = exp(FLOAT_TYPE(data_g[g_base + i]));
            }
        }

        const FLOAT_TYPE v_val = FLOAT_TYPE(data_v[v_off + col]);
#endif

        FLOAT_TYPE kv_shard = 0.0;
        [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
            kv_shard += g_exp[r] * s_shard[r] * k_reg[r];
        }
        FLOAT_TYPE kv_col = reduce_partial(kv_shard);

        FLOAT_TYPE delta_col = (v_val - kv_col) * beta_val;

        FLOAT_TYPE attn_partial = 0.0;
        [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
            s_shard[r] = g_exp[r] * s_shard[r] + k_reg[r] * delta_col;
            attn_partial += s_shard[r] * q_reg[r];
        }
        FLOAT_TYPE attn_col = reduce_partial(attn_partial);

#if GDN_REPLAY
        if (ti >= 0) {
            if (lane == 0) {
                data_dst[attn_off + col] = attn_col * scale;
            }
            attn_off += S_V * H;
        }

        // a deferred token keeps its inputs (k once per key head, g / beta once per head) for the next pass
        if (ti > tc) {
            const uint row = st_wr + uint(ti - tc - 1) * st_row;
            if (col == 0) {
                [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                    const uint i = r * LANES_PER_COLUMN + lane;
                    if (head_id < neq1) {
                        data_stash[row + head_id * S_V + i] = k_reg[r];
                    }
                    if (KDA != 0) {
                        data_stash[row + st_g + head_id * S_V + i] = g_raw[r];
                    }
                }
                if (lane == 0) {
                    if (KDA == 0) {
                        data_stash[row + st_g + head_id] = g_raw[0];
                    }
                    data_stash[row + st_b + head_id] = beta_val;
                }
            }
            if (lane == 0) {
                data_stash[row + st_v + head_id * S_V + col] = v_val;
            }
        }

        if (ti == tc) {
            [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                data_dst_state[state_dst + col * S_V + r * LANES_PER_COLUMN + lane] = s_shard[r];
            }
        }
    }
#else
        if (lane == 0) {
            data_dst[attn_off + col] = attn_col * scale;
        }

        attn_off += S_V * H;

        // slot 0 is the state after the last token, slot s the state s tokens back; slots >= K are
        //   not written (they belong to an older batch)
        const int target_slot = int(n_tokens) - 1 - int(t);
        if (target_slot < int(K)) {
            const uint slot_base = state_out_base + uint(target_slot) * so2;
            [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                data_dst_state[slot_base + col * S_V + r * LANES_PER_COLUMN + lane] = s_shard[r];
            }
        }
    }
#endif
}
