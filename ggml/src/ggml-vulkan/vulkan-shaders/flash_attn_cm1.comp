#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

#if defined(BFLOAT16)
#extension GL_EXT_bfloat16 : enable
#endif

#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_cooperative_matrix : enable

#include "types.glsl"
#define FA_PV_ACC_TYPE 1
#include "flash_attn_base.glsl"
#include "flash_attn_vis.glsl"
#if !defined(BFLOAT16)
#include "flash_attn_dequant.glsl"
#endif

// These need to be supported N,M values for a MatBc x MatBr x 16 coopmatmuladd
const uint32_t MatBr = 16;
const uint32_t MatBc = 16;

// [TAG_FA_CM1_ROW_TILES] A workgroup covers its Br query rows as Br / MatBr coopmat row
// tiles of MatBr rows each.  row_tiles == 1 (Br == MatBr == 16) is the historical tile:
// every "row_tiles > 1" branch below is a spec-constant condition that folds away at
// specialization, leaving exactly the code that shipped before this change.  row_tiles == 2
// (Br == 32) halves how often a workgroup has to stream its KV head, which is the whole
// point: this kernel is bandwidth-bound at prefill shapes.  Only 1 and 2 are implemented -
// Br == 64 does not fit 64 KB of shared memory at HSK == HSV == 256 anyway - and both
// get_fa_tuning_params_coopmat1 and ggml_vk_flash_attn_coopmat_shmem_support cap Br at 32.
const uint32_t row_tiles = Br / MatBr;

// [TAG_FA1] two shared-memory layouts of this kernel (Flags bits 16384 / 32768, host knobs GGML_VK_FA_SFPV_ALIAS /
// GGML_VK_FA_V_CHUNK).  The kernel is occupancy-bound by shared memory on RDNA3 at HSK == HSV == 256 (128 VGPRs
// allow 8 subgroups per SIMD, 31 KiB of LDS allows 4), so these shrink it.  Neither changes an operand, the order
// of any coopMatMulAdd, or a softmax/accumulation step - a dispatch's output is bit-identical with or without them.
//   SFPV_ALIAS: pvsh lives in sfsh's storage.  sfsh (the S tile) is dead once P is in Psh (the barrier before the
//               P*V blocks) and is next written by the next KV tile's K*Q^T store, after the barrier that closes
//               this KV tile; pvsh is live only between those two barriers.  -4 KiB at Br 16, f32 accumulation.
//   V_CHUNK:    when a V tile has to be staged through kvsh (mask-dead columns replaced by +0, KV bounds, quant V),
//               it is staged one MatBc-row chunk at a time right before that chunk's coopMatMulAdd instead of all Bc
//               rows at once, so kvsh only needs max(Bc x K chunk, MatBc x V chunk).  -5 KiB; costs two barriers per
//               chunk on staged tiles only.  Host: row_tiles == 1, no SHMEM_STAGING, f16 V (no per-tile decode).
const bool SFPV_ALIAS = (Flags & 16384) != 0;
// V_CHUNK is only defined for one row tile (the row_tiles > 1 paths - PVMat1, the dead_split staging of Bc rows -
// need the whole-tile kvsh), for dense KV tiles (the per-chunk direct V load reads rows j * Bc + c, not ids) and
// without whole-tile staging, so the kernel itself folds those conditions in: a dispatch that sets the bit on any
// other pipeline gets the legacy layout, never a dropped P*V term or an out-of-bounds kvsh write.
const bool V_CHUNK    = (Flags & 32768) != 0 && row_tiles == 1 && !INDEXED && SHMEM_STAGING == 0;

const uint32_t rows_per_thread = Br / row_split;
const uint32_t cols_per_iter = gl_WorkGroupSize.x / row_split;
const uint32_t cols_per_thread = Bc / cols_per_iter;


layout (binding = 0) readonly buffer Q {float data_q[];};
layout (binding = 0) readonly buffer QV4 {vec4 data_qv4[];};
layout (binding = 1) readonly buffer K {FLOAT_TYPE data_k[];};
layout (binding = 1) readonly buffer KV4 {FLOAT_TYPEV4 data_kv4[];};
layout (binding = 2) readonly buffer V {FLOAT_TYPE data_v[];};
layout (binding = 2) readonly buffer VV4 {FLOAT_TYPEV4 data_vv4[];};
layout (binding = 3) readonly buffer M {float16_t data_m[];};

shared float tmpsh[row_split];

const uint32_t qstride = HSK_pad / 4 + 2;
shared FLOAT_TYPEV4 Qf[Br * qstride];

const uint psh_stride = Br / 4 + 2;
shared FLOAT_TYPEV4 Psh[Bc * psh_stride];

// Avoid padding for hsk==256 to make it fit in 48KB shmem.
const uint32_t sfshstride = (HSK <= 128) ? (Br / 4 + 2) : Br / 4;
// pvsh's first index is a query row of the Br tile, so it holds row_tiles coopmat tiles.
const uint32_t osh_stride = row_split * MatBr / 4;
const uint32_t sfsh_len = Bc * sfshstride;
const uint32_t pvsh_len = Br * osh_stride;
// [TAG_FA1] SFPV_ALIAS: sfsh also holds pvsh (O_TYPE == ACC_TYPE here, FA_PV_ACC_TYPE)
shared ACC_TYPEV4 sfsh[SFPV_ALIAS ? (pvsh_len > sfsh_len ? pvsh_len : sfsh_len) : sfsh_len];

const uint32_t D_pad = HSK_pad > HSV_pad ? HSK_pad : HSV_pad;
const uint32_t kvsh_stride = (SHMEM_STAGING != 0 ? D_pad : MatBr) / 4 + 2;
const uint v_cols = MatBc / 4 * row_split; // total cols, 4 vec4s per MatBc * number of subgroups
const uint vsh_stride = v_cols;
// [TAG_FA1] V_CHUNK: V is staged MatBc rows at a time, and K is staged at all only where the K*Q^T loop's stage_k
// can be true (INDEXED, a decoded K type, KV bounds, a ragged HSK) - an aligned f16 pipeline reads K straight from
// global memory, so kvsh is just the V chunk there.
const uint32_t v_stage_rows = V_CHUNK ? MatBc : Bc;
const uint32_t k_stage_possible = (INDEXED ? 1u : 0u) + (USE_DECODE_K ? 1u : 0u) + (KV_bounds_check ? 1u : 0u) +
                                  ((HSK % 16) != 0 ? 1u : 0u) + (SHMEM_STAGING != 0 ? 1u : 0u) + (V_CHUNK ? 0u : 1u);
const uint32_t k_stage_len = k_stage_possible != 0 ? Bc * kvsh_stride : 0u;
shared FLOAT_TYPEV4 kvsh[(k_stage_len >= v_stage_rows * vsh_stride) ? k_stage_len : (v_stage_rows * vsh_stride)];

shared O_TYPEV4 pvsh[SFPV_ALIAS ? 1 : pvsh_len];

shared ACC_TYPE slope[Br];

// [TAG_QSA_INDEXED_FA] this KV tile's cell ids, or the dead sentinel KV for a column >= W and for an out-of-range id.
// FA_KV_LIVE(j, c): tile column c is a real cell (indexed: its id is in [0, KV); dense: the KV tail bound).
// FA_KV_ROW(j, c): the cache row of tile column c; the clamp keeps even a dead column's address in bounds
// (FA pipelines run without robustBufferAccess) - it never makes a dead column live.
shared uint32_t idsh[INDEXED ? Bc : 1];
#define FA_KV_LIVE(j, c) (INDEXED ? idsh[(c)] < KV : ((j) * Bc + (c)) < KV)
#define FA_KV_ROW(j, c) (INDEXED ? min(idsh[(c)], KV - 1u) : ((j) * Bc + (c)))

// ZERO_DEAD_V: "this KV column is mask-suppressed for every row of this coopmat row tile",
// as a Bc-bit column mask, one mask per row tile.  The predicate is per row tile and not per
// Br tile because V is coopMatMulAdd's shared B operand across the MatBr rows of one tile
// and no wider: a column may only be replaced by +0 for a tile in which it is dead for every
// one of that tile's rows.  At row_tiles == 1 this is exactly the Br-wide predicate that
// shipped before.
//
// This is also why GQA_TOKENS packs its (token, head) rows token-aligned: the predicate is a
// reduction over the rows of a row tile, so a tile that mixed two tokens would lose exactly
// the columns that a causal mask suppresses for the earlier token and not the later one -
// the causal-boundary tile - and reopen the RDNA3 signed-zero hazard for that token.  See
// [TAG_FA_GQA_TOKENS] in flash_attn_base.glsl.
const uint32_t dead_words = (Bc + 31) / 32;

// Default path: one mask per row group.  Each subgroup reduces the P values its threads
// still hold in registers, so Psh is never re-read and no barrier of its own is needed - the
// publish rides the barrier that already precedes the P*V matmul.  The row groups partition
// [0, Br) and MatBr / rows_per_thread consecutive groups cover one row tile, so ANDing that
// group of masks is the row tile's verdict.
shared uint32_t p_dead_sg[row_split * dead_words];

// DEADV_LDS A/B path: the same masks, rebuilt by re-reading Psh behind two extra barriers.
shared uint32_t p_dead_lds[row_tiles * dead_words];

// Workgroup-uniform copies of the masks, plus "this row tile has a dead column at all".
uint32_t dead_cols[row_tiles * dead_words];
bool any_dead_tile[row_tiles];

// Stage rows [row0, row0 + nrows) of one [Bc, MatBc * row_split] slice of V into kvsh rows [dst_row0, +nrows),
// replacing the rows (KV columns) that row tile "t" has marked dead by +0 when zero_dead is set.  The whole-tile
// staging (stage_v_columns) and V_CHUNK's per-chunk staging are both this one per-element rule.
void stage_v_rows(const uint32_t j, const uint32_t hsv_tile, const uint32_t v_offset,
                  const uint32_t tid, const uint32_t t, const bool zero_dead,
                  const uint32_t row0, const uint32_t nrows, const uint32_t dst_row0) {
    const uint n_elems = nrows * v_cols;
    const uint v_loads_per_thread = (n_elems + gl_WorkGroupSize.x - 1) / gl_WorkGroupSize.x;

    [[unroll]] for (uint32_t l = 0; l < v_loads_per_thread; ++l) {
        const uint idx = l * gl_WorkGroupSize.x + tid;
        // folds to true when the workgroup divides the slice (the whole-tile case)
        if ((n_elems % gl_WorkGroupSize.x) == 0 || idx < n_elems) {
            const uint lrow = idx / v_cols;
            const uint col = idx % v_cols;
            const uint row = row0 + lrow;
            const uint dst = (dst_row0 + lrow) * vsh_stride + col;

            const uint v_row = FA_KV_ROW(j, row);
            const uint v_col = hsv_tile * MatBc * row_split + col * 4;

            const uint coord = v_row * v_stride * BLOCK_SIZE_V + v_col;
            const uint ib = coord / BLOCK_SIZE_V;
            const uint iqs = coord % BLOCK_SIZE_V;

            const bool row_dead = zero_dead &&
                                  ((dead_cols[t * dead_words + row / 32] & (1u << (row % 32))) != 0);
            if (row_dead) {
                kvsh[dst] = FLOAT_TYPEV4(0.0f);
            // [TAG_QSA_INDEXED_FA] (Check-in #9 a) indexed: the column is one of the W ids AND its cell is in the cache
            } else if (!KV_bounds_check || (FA_KV_LIVE(j, row) && v_col < HSV)) {
#if !defined(BFLOAT16)
                if (USE_DECODE_V) {
                    kvsh[dst] = dequantize4(ib, iqs, v_offset, BINDING_IDX_V);
                } else
#endif
                {
                    kvsh[dst] = data_vv4[(v_offset + v_row * v_stride + v_col) / 4];
                }
            } else {
                kvsh[dst] = FLOAT_TYPEV4(0.0f);
            }
        }
    }
}

// The whole [Bc, MatBc * row_split] slice for row tile "t".
void stage_v_columns(const uint32_t j, const uint32_t hsv_tile, const uint32_t v_offset,
                     const uint32_t tid, const uint32_t t, const bool zero_dead) {
    stage_v_rows(j, hsv_tile, v_offset, tid, t, zero_dead, 0u, Bc, 0u);
}

// [TAG_FA1] V_CHUNK: rows [bc_chunk * MatBc, +MatBc) of the slice into kvsh rows [0, MatBc) (one row tile, t = 0).
void stage_v_chunk(const uint32_t j, const uint32_t hsv_tile, const uint32_t bc_chunk, const uint32_t v_offset,
                   const uint32_t tid, const bool zero_dead) {
    stage_v_rows(j, hsv_tile, v_offset, tid, 0u, zero_dead, bc_chunk * MatBc, MatBc, 0u);
}

// The V operand of one P*V coopMatMulAdd, from global memory or from the kvsh staging tile.
#define FA_LOAD_V_TILE(staged)                                                                                       \
    if (SHMEM_STAGING == 0) {                                                                                        \
        if (!(staged) && !INDEXED) {                                                                                 \
            /* F16/BF16 values can be loaded directly from global memory */                                          \
            const uint v_tile_row = j * Bc + bc_chunk * MatBc;                                                       \
            const uint v_tile_offset = v_offset / 4 + v_tile_row * v_stride / 4 + hsv_offset / 4;                    \
            coopMatLoad(QMat, data_vv4, v_tile_offset, v_stride / 4, gl_CooperativeMatrixLayoutRowMajor);            \
        } else {                                                                                                     \
            const uint v_tile_offset = bc_chunk * MatBr * v_cols + gl_SubgroupID * (MatBc / 4);                      \
            coopMatLoad(QMat, kvsh, v_tile_offset, vsh_stride, gl_CooperativeMatrixLayoutRowMajor);                  \
        }                                                                                                            \
    } else {                                                                                                         \
        const uint v_tile_offset = bc_chunk * MatBc * kvsh_stride + (hsv_tile * row_split + gl_SubgroupID) * (MatBc / 4); \
        coopMatLoad(QMat, kvsh, v_tile_offset, kvsh_stride, gl_CooperativeMatrixLayoutRowMajor);                     \
    }

// [TAG_KQ_VIS] a mask element of query row R and tile column C (0 <= C < Bc): the plane's, or the same f16 value
// computed from the metadata (the tile staged in buffer j & 1, see flash_attn_vis.glsl).
// [TAG_QSA_INDEXED_FA] the plane is read at the column's cache row FA_KV_ROW(j, C) (j * Bc + C when not INDEXED);
// with VIS the staging already holds the records of the tile's cells (INDEXED: of its ids).
#define FA_MASK_LOAD(R, C) (VIS ? float16_t(fa_vis_value_b(j & 1u, (R) - i * Br, (C))) : data_m[m_offset + fa_mask_row(R) * m_stride + FA_KV_ROW(j, (C))])

void main() {
#ifdef NEEDS_INIT_IQ_SHMEM
    if (fa_type_needs_shmem(FaTypeK) || fa_type_needs_shmem(FaTypeV)) {
        init_iq_shmem(gl_WorkGroupSize);
    }
#endif

    init_indices();
    if (VIS) {
        fa_vis_init();
    }

    const uint32_t tid = gl_LocalInvocationIndex;

    const uint32_t threads_per_rowgroup = gl_WorkGroupSize.x / row_split;
    const uint32_t d_per_thread = (HSV/4 + threads_per_rowgroup - 1) / threads_per_rowgroup;
    const uint32_t row_tid = gl_LocalInvocationIndex / threads_per_rowgroup;
    const uint32_t col_tid = gl_LocalInvocationIndex % threads_per_rowgroup;

#define tile_row(r) (row_tid * rows_per_thread + (r))

    // Zero-initialize shared memory for Q/K when HSK is not a multiple of 16 (HSK_pad > HSK).
    if ((HSK % 16) != 0) {
        [[unroll]] for (uint i = 0; i < Br * qstride; i += gl_WorkGroupSize.x) {
            if (i + tid < Br * qstride) {
                Qf[i + tid] = FLOAT_TYPEV4(0);
            }
        }
        barrier();
    }

    uint32_t q_offset = gqa_iq1*p.nb01 + (iq2*p.nb02+iq3*p.nb03) / 4;

    [[unroll]] for (uint32_t idx = 0; idx < Br * HSK / 4; idx += gl_WorkGroupSize.x) {
        uint32_t d = (idx + tid) % (HSK / 4);
        uint32_t r = (idx + tid) / (HSK / 4);
        if (r < Br && d < HSK / 4 &&
            i * Br + r < N) {
            // fa_q_row_offset4 is "(i * Br + r) * q_stride / 4" unless GQA_TOKENS folds the
            // token into the row, in which case the row picks its own (token, head) Q row.
            Qf[r * qstride + d] = FLOAT_TYPEV4(data_qv4[q_offset / 4 + fa_q_row_offset4(i * Br + r) + d] * p.scale);
        }
    }
    barrier();

    O_TYPEV4 Of[rows_per_thread][d_per_thread];
    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        [[unroll]] for (uint32_t d = 0; d < d_per_thread; ++d) {
            Of[r][d] = O_TYPEV4(0.0);
        }
    }

    float Lf[rows_per_thread], Mf[rows_per_thread];

    // Use -FLT_MAX/2 rather than -inf to reduce the possibility of NaNs, e.g. when computing Mold-M.
    const float NEG_FLT_MAX_OVER_2 = uintBitsToFloat(0xFEFFFFFF);

    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        Lf[r] = 0;
        Mf[r] = NEG_FLT_MAX_OVER_2;
    }

    // ALiBi
    if (p.max_bias > 0.0f) {
        if (tid < Br) {
            uint r = tid;
            // The head of a row is (global row) % gqa_ratio.  i is 0 in the plain GQA fold,
            // and perElemOpComputeSlope ignores the row when gqa_ratio == 1, so only GQA_TOKENS
            // needs the global row - spelled out so the other two paths keep the old index.
            slope[r] = perElemOpComputeSlope(GQA_TOKENS ? (i * Br + r) : r, col_tid, ACC_TYPE(0), iq2);
        }
    } else {
        if (tid < Br) {
            uint r = tid;
            slope[r] = ACC_TYPE(1.0);
        }
    }

    const uint32_t mo_stride = CEIL_DIV(KV, 16 * Bc);
    // mo_offset will point to the tile starting at row i*Br and col 0.
    // With GQA_TOKENS every row tile draws its mask rows from [0, n_tokens), and the dispatch
    // guarantees n_tokens <= Br, so mask-opt block row 0 summarizes all of them.  It also folds
    // in this block row's padding mask rows, which can only turn an ALL_ZERO verdict into
    // "mixed" (one extra mask load) - never the other way round.
    uint32_t mo_offset = mo_stride * (GQA_TOKENS ? 0 : i);

    // FaBlockBytesK/V == 2 for f16 (sizeof f16) and == 16 for f32 (vec4) and == ggml block size for quants.
    uint32_t k_offset = (ik2*p.nb12 + ik3*p.nb13) / FaBlockBytesK;
    uint32_t v_offset = (iv2*p.nb22 + iv3*p.nb23) / FaBlockBytesV;
    uint32_t m_offset = gqa_iq1*KV;
    if (p.nem2 != 1 || p.nem3 != 1) {
        m_offset += ((iq3 % p.nem3) * p.nem2 + (iq2 % p.nem2)) * p.nem1 * KV;
        mo_offset += ((iq3 % p.nem3) * p.nem2 + (iq2 % p.nem2)) * CEIL_DIV(p.nem1, Br) * mo_stride;
    }

    uint32_t mask_opt = 0;
    uint32_t mask_opt_idx = ~0;
    uint32_t mask_opt_bits = 0;
    f16vec4 mask_cache[Bc * Br / 4 / WorkGroupSize];

    // ZERO_DEAD_V / output stores: row "row" of this Br tile carries a real query only if it is
    // inside the batch and - under GQA_TOKENS - is not one of the rows that pad its token out
    // to a whole MatBr row tile.  Padding rows load a duplicate of their token's last head
    // (fa_q_row_offset4), so their P is a real nonzero value and would defeat the dead-column
    // test; they are excluded here and their outputs are never stored.  Takes the tile-local
    // row so that, with GQA_TOKENS specialized off, it is literally the "row < n_valid" the
    // shader used before the fold existed.
    const uint32_t n_valid = min(Br, N - i * Br);
#define fa_row_live(row) (GQA_TOKENS ? (i * Br + (row) < N && !FA_ROW_PAD(i * Br + (row))) : ((row) < n_valid))
    const uint32_t ids_offset = (iq3 * p.ne2 + gqa_iq1) * p.split_kv; // [TAG_QSA_INDEXED_FA] plain fold: token = gqa_iq1, p.ne2 = n_tps

    // [TAG_KQ_VIS] the first tile's visibility, staged before the loop; every later tile is staged one
    // iteration ahead (below), ordered by the barriers the previous iteration already has.
    // [TAG_QSA_VIS] INDEXED stages each tile with its ids instead (the idsh fill below)
    if (VIS && !INDEXED) {
        if (start_j < end_j) {
            fa_vis_stage(start_j, start_j & 1u);
        }
        barrier();
    }

    [[dont_unroll]]
    for (uint32_t j = start_j; j < end_j; ++j) {
        if (INDEXED) {
            // No barrier before the fill: the previous tile's last barrier (end of this loop body) orders every
            // idsh reader of that tile, and the only `continue` reachable with INDEXED (the all -inf mask skip)
            // follows the mask-reduce barriers, after that tile's last idsh read (the mask load).
            if (tid < Bc) {
                const uint32_t pos = j * Bc + tid;
                // Columns >= W and out-of-range ids (a negative one wraps to a huge uint) get the sentinel KV:
                // FA_KV_LIVE bounds them like a KV tail (P = +0, K/V/mask never loaded), instead of attending a
                // clamped - possibly live - cell KV-1. FA_KV_ROW clamps the address separately.
                const uint32_t cell = pos < p.split_kv ? min(uint32_t(data_ids[ids_offset + pos]), KV) : KV;
                idsh[tid] = cell;
                if (VIS) {
                    // [TAG_QSA_VIS] (A4 T4) the tile's visibility from the records of the cells its ids name, into buffer
                    // j & 1 (FA_MASK_LOAD's); its last reads were iteration j - 2's mask loads, behind that iteration's
                    // barriers, and the barrier below orders these writes before this tile's mask loads
                    fa_vis_stage_cell(cell, tid, j & 1u);
                }
            }
            barrier();
        }

        [[unroll]] for (uint32_t idx = 0; idx < mask_cache.length(); ++idx) {
            mask_cache[idx] = f16vec4(0);
        }

        // [TAG_KQ_VIS] stage tile j + 1 into the other buffer, if the plane path will load its mask
        // (not a mask-opt ALL_NEG_INF / ALL_ZERO tile). Buffer (j + 1) & 1 was last read by iteration
        // j - 1's mask loads, which the all -inf test's barrier of that iteration follows; these writes
        // are read by iteration j + 1's mask loads after this iteration's barriers (the sfsh store
        // barrier, or the one before the ALL_NEG_INF "continue" below).
        if (VIS && !INDEXED && j + 1 < end_j) {
            const uint jn = j + 1;
            bool need = true;
            if (USE_MASK_OPT) {
                const uint nbits = (data_mask_opt[mo_offset + jn / 16] >> ((jn % 16) * 2)) & 0x3;
                need = nbits != MASK_OPT_ALL_NEG_INF && nbits != MASK_OPT_ALL_ZERO;
            }
            if (need) {
                fa_vis_stage(jn, jn & 1u);
            }
        }

        if (MASK_ENABLE) {
            if (USE_MASK_OPT && mask_opt_idx != j / 16) {
                mask_opt_idx = j / 16;
                mask_opt = data_mask_opt[mo_offset + mask_opt_idx];
            }
            mask_opt_bits = (mask_opt >> ((j % 16) * 2)) & 0x3;
            if (mask_opt_bits == MASK_OPT_ALL_NEG_INF) {
                // skip this block
                if (VIS) {
                    barrier(); // [TAG_KQ_VIS] orders the staging of tile j + 1 above before its reads
                }
                continue;
            }
            // Only load if the block is not all zeros
            if (mask_opt_bits != MASK_OPT_ALL_ZERO) {
                bool nem1_bounds_check = !(p.gqa_ratio > 1) && (p.nem1 % Br) != 0;

                float max_mask = NEG_FLT_MAX_OVER_2;
                [[unroll]] for (uint32_t idx = 0; idx < Bc * Br / 4; idx += gl_WorkGroupSize.x) {
                    uint32_t c = (idx + tid) / (Br / 4);
                    uint32_t r = (idx + tid) % (Br / 4);
                    if (idx + tid < Bc * Br / 4 || idx + gl_WorkGroupSize.x <= Bc * Br / 4) {
                        if ((!KV_bounds_check || FA_KV_LIVE(j, c))) {
                            f16vec4 m;
                            if (!nem1_bounds_check || i * Br + r * 4 + 3 < p.nem1) {
                                // fa_mask_row(R) is R itself unless GQA_TOKENS makes the rows
                                // (token, head) pairs, in which case it is the row's token.
                                m = f16vec4(FA_MASK_LOAD(i * Br + r * 4, c),
                                            FA_MASK_LOAD(i * Br + r * 4 + 1, c),
                                            FA_MASK_LOAD(i * Br + r * 4 + 2, c),
                                            FA_MASK_LOAD(i * Br + r * 4 + 3, c));
                                max_mask = max(max(max(max(max_mask, float(m[0])), float(m[1])), float(m[2])), float(m[3]));
                            } else if (i * Br + r * 4 + 2 < p.nem1) {
                                m = f16vec4(FA_MASK_LOAD(i * Br + r * 4, c),
                                            FA_MASK_LOAD(i * Br + r * 4 + 1, c),
                                            FA_MASK_LOAD(i * Br + r * 4 + 2, c),
                                            0.0);
                                max_mask = max(max(max(max_mask, float(m[0])), float(m[1])), float(m[2]));
                            } else if (i * Br + r * 4 + 1 < p.nem1) {
                                m = f16vec4(FA_MASK_LOAD(i * Br + r * 4, c),
                                            FA_MASK_LOAD(i * Br + r * 4 + 1, c),
                                            0.0,
                                            0.0);
                                max_mask = max(max(max_mask, float(m[0])), float(m[1]));
                            } else if (i * Br + r * 4 < p.nem1) {
                                m = f16vec4(FA_MASK_LOAD(i * Br + r * 4, c),
                                            0.0,
                                            0.0,
                                            0.0);
                                max_mask = max(max_mask, float(m[0]));
                            } else {
                                m = f16vec4(0.0);
                            }
                            mask_cache[idx / WorkGroupSize] = m;
                        }
                    }
                }
                // skip the block if the mask is entirely -inf
                bool all_less = subgroupAll(max_mask <= NEG_FLT_MAX_OVER_2);
                barrier();
                if (gl_SubgroupInvocationID == 0) {
                    tmpsh[gl_SubgroupID] = all_less ? NEG_FLT_MAX_OVER_2 : 0.0f;
                }
                barrier();
                [[unroll]] for (uint s = 0; s < gl_NumSubgroups; ++s) {
                    max_mask = max(max_mask, tmpsh[s]);
                }
                if (max_mask <= NEG_FLT_MAX_OVER_2) {
                    continue;
                }
            }
        }

        if (SHMEM_STAGING != 0) {
            [[unroll]] for (uint32_t idx = 0; idx < Bc * HSK_pad / 4; idx += gl_WorkGroupSize.x) {
                uint32_t d = (idx + tid) % (HSK_pad / 4);
                uint32_t c = (idx + tid) / (HSK_pad / 4);
                if (idx + gl_WorkGroupSize.x <= Bc * HSK_pad / 4 || c < Bc) {
                    FLOAT_TYPEV4 K_Tf = FLOAT_TYPEV4(0);
                    if ((!KV_bounds_check || FA_KV_LIVE(j, c)) && (HSK == HSK_pad || d < HSK / 4)) {
#if !defined(BFLOAT16)
                        if (USE_DECODE_K) {
                            uint coord = FA_KV_ROW(j, c) * k_stride * BLOCK_SIZE_K + 4 * d;
                            uint ib = coord / BLOCK_SIZE_K;
                            uint iqs = (coord % BLOCK_SIZE_K);
                            K_Tf = dequantize4(ib, iqs, k_offset, BINDING_IDX_K);
                        } else
#endif
                        {
                            K_Tf = FLOAT_TYPEV4(data_kv4[k_offset / 4 + FA_KV_ROW(j, c) * k_stride / 4 + d]);
                        }
                    }

                    kvsh[c * kvsh_stride + d] = K_Tf;
                }
            }
            barrier();
        }

        // K * Q^T -> S^T: Bc x HSK_pad * HSK_pad x Br -> Bc x Br
        // Bc split across workgroup (four subgroups), loop over HSK in chunks of 16: 16 x 16 * 16 x 16 -> 16 x 16
        // This is written transposed in order to allow for N being 8 if implementations need it
        coopmat<ACC_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator> SfMat0 = coopmat<ACC_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator>(0);
        coopmat<ACC_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator> SfMat1 = coopmat<ACC_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator>(0);
        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, MatBc, 16, gl_MatrixUseA> KMat;
        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 16, MatBr, gl_MatrixUseB> QMat;

        [[unroll]] for (uint32_t d = 0; d < HSK_pad / 16; ++d) {
            // If SHMEM_STAGING is set, a Bc * HSK_pad size tile of K is loaded to shmem
            // If not, K is loaded directly from global memory if aligned, otherwise
            // staged through a Bc * MatBr size staging buffer.
            // If K is a quant type, then it is always staged for dequantization.
            if (SHMEM_STAGING == 0) {
            // For quants we always need to dequant into kvsh; for f16/bf16 we can load
            // directly from global memory when alignment / bounds allow it.
            const bool stage_k = INDEXED || USE_DECODE_K || KV_bounds_check || d * 16 + 16 > HSK;
            if (stage_k) {
                barrier();
                [[unroll]] for (uint32_t idx = 0; idx < Bc * MatBr / 4; idx += gl_WorkGroupSize.x) {
                    uint32_t col_vec = (idx + tid) % (MatBr / 4);
                    uint32_t row = (idx + tid) / (MatBr / 4);
                    if (idx + tid < Bc * MatBr / 4) {
                        FLOAT_TYPEV4 K_Tf = FLOAT_TYPEV4(0);
                        if ((!KV_bounds_check || FA_KV_LIVE(j, row)) && (HSK == HSK_pad || d * 16 + col_vec * 4 < HSK)) {
#if !defined(BFLOAT16)
                            if (USE_DECODE_K) {
                                uint coord = FA_KV_ROW(j, row) * k_stride * BLOCK_SIZE_K + d * 16 + col_vec * 4;
                                uint ib = coord / BLOCK_SIZE_K;
                                uint iqs = (coord % BLOCK_SIZE_K);
                                K_Tf = dequantize4(ib, iqs, k_offset, BINDING_IDX_K);
                            } else
#endif
                            {
                                K_Tf = FLOAT_TYPEV4(data_kv4[k_offset / 4 + FA_KV_ROW(j, row) * k_stride / 4 + d * 16 / 4 + col_vec]);
                            }
                        }

                        kvsh[row * kvsh_stride + col_vec] = K_Tf;
                    }
                }
                barrier();
            }

            if (stage_k) {
                uint coord = (gl_SubgroupID * MatBc) * kvsh_stride;
                coopMatLoad(KMat, kvsh, coord, kvsh_stride, gl_CooperativeMatrixLayoutRowMajor);
            } else {
                const uint coord = k_offset / 4 + (j * Bc + gl_SubgroupID * MatBc) * k_stride / 4 + d * 16 / 4;
                coopMatLoad(KMat, data_kv4, coord, k_stride / 4, gl_CooperativeMatrixLayoutRowMajor);
            }
            } else {
                uint coord = (gl_SubgroupID * MatBc) * kvsh_stride + d * 16 / 4;
                coopMatLoad(KMat, kvsh, coord, kvsh_stride, gl_CooperativeMatrixLayoutRowMajor);
            }

            // Both row tiles multiply the *same* KMat, in the same d order, by their own
            // MatBr columns of Q, so a query row's QK accumulation chain is exactly the one
            // it gets at Br == MatBr.  Only the tile it shares a workgroup with changes.
            coopMatLoad(QMat, Qf, d * 16 / 4, qstride, gl_CooperativeMatrixLayoutColumnMajor);
            SfMat0 = coopMatMulAdd(KMat, QMat, SfMat0);

            if (row_tiles > 1) {
                coopMatLoad(QMat, Qf, MatBr * qstride + d * 16 / 4, qstride, gl_CooperativeMatrixLayoutColumnMajor);
                SfMat1 = coopMatMulAdd(KMat, QMat, SfMat1);
            }
        }

        // sfsh is [Bc][Br]: row tile t owns scalar rows [t * MatBr, +MatBr) of each column.
        uint coord = gl_SubgroupID * MatBc * sfshstride;
        coopMatStore(SfMat0, sfsh, coord, sfshstride, gl_CooperativeMatrixLayoutRowMajor);
        if (row_tiles > 1) {
            coopMatStore(SfMat1, sfsh, coord + MatBr / 4, sfshstride, gl_CooperativeMatrixLayoutRowMajor);
        }
        barrier();

        if (LOGIT_SOFTCAP) {
            [[unroll]] for (uint32_t idx = 0; idx < Bc * Br / 4; idx += gl_WorkGroupSize.x) {
                uint32_t c = (idx + tid) / (Br / 4);
                uint32_t r = (idx + tid) % (Br / 4);
                if (idx + tid < Bc * Br / 4 || idx + gl_WorkGroupSize.x <= Bc * Br / 4) {
                    sfsh[c * sfshstride + r] = ACC_TYPEV4(p.logit_softcap * tanh(sfsh[c * sfshstride + r]));
                }
            }
            barrier();
        }

        if (MASK_ENABLE && mask_opt_bits != MASK_OPT_ALL_ZERO) {
            [[unroll]] for (uint32_t idx = 0; idx < Bc * Br / 4; idx += gl_WorkGroupSize.x) {
                uint32_t c = (idx + tid) / (Br / 4);
                uint32_t r = (idx + tid) % (Br / 4);
                if (idx + tid < Bc * Br / 4 || idx + gl_WorkGroupSize.x <= Bc * Br / 4) {
                    if (!KV_bounds_check || FA_KV_LIVE(j, c)) {
                        // Mask nem1 bounds check is handled when loading masks
                        ACC_TYPEV4 masks = ACC_TYPEV4(mask_cache[idx / WorkGroupSize]);
                        ACC_TYPEV4 slopes = ACC_TYPEV4(slope[r * 4], slope[r * 4 + 1], slope[r * 4 + 2], slope[r * 4 + 3]);
                        sfsh[c * sfshstride + r] += slopes * masks;
                    }
                }
            }
            barrier();
        }

        float eMf[rows_per_thread];
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            const uint r_vec  = tile_row(r) / 4;
            const uint r_comp = tile_row(r) % 4;

            float rowmaxf = NEG_FLT_MAX_OVER_2;
            [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
                if (KV_bounds_check && !FA_KV_LIVE(j, c * cols_per_iter + col_tid)) {
                    continue;
                }
                rowmaxf = max(rowmaxf, float(sfsh[r_vec + (c * cols_per_iter + col_tid) * sfshstride][r_comp]));
            }
            rowmaxf += FATTN_KQ_MAX_OFFSET;
            float Moldf = Mf[r];

            // Compute max across the row
            rowmaxf = subgroupMax(rowmaxf);

            // M = max(rowmax, Mold)
            // P = e^(S - M)
            // eM = e^(Mold - M)
            Mf[r] = max(rowmaxf, Moldf);
            eMf[r] = exp(Moldf - Mf[r]);

            Lf[r] = eMf[r]*Lf[r];
        }

        [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
            const uint d_local = d0 / threads_per_rowgroup;
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                Of[r][d_local] = O_TYPE(eMf[r]) * Of[r][d_local];
            }
        }

        // ZERO_DEAD_V: thread (row_tid, col_tid) writes rows
        // [row_tid * rows_per_thread, +rows_per_thread) of every column it owns, so it can
        // fold its own P values into a per-column flag right here.  Those rows all fall in
        // one row tile; the other groups covering that tile are ANDed in below.
        bool p_dead_col[cols_per_thread];
        [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
            p_dead_col[c] = true;
        }

        // Calculate and store Pf in Psh
        [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
            const uint col = c * cols_per_iter + col_tid;

            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; r += 4) {
                const uint row = tile_row(r);
                if (KV_bounds_check && !FA_KV_LIVE(j, col)) {
                    // stored as +0 for every row, so the column stays a dead-column candidate
                    Psh[col * psh_stride + row / 4] = FLOAT_TYPEV4(0.0f);
                } else {
                    const vec4 mfvec = vec4(Mf[r], Mf[r + 1], Mf[r + 2], Mf[r + 3]);
                    const FLOAT_TYPEV4 Pf = FLOAT_TYPEV4(exp(vec4(sfsh[row / 4 + col * sfshstride]) - mfvec));
                    [[unroll]] for (uint32_t vec_idx = 0; vec_idx < 4; ++vec_idx) {
                        Lf[r + vec_idx] += Pf[vec_idx];
                    }
                    Psh[col * psh_stride + row / 4] = Pf;
                    if (ZERO_DEAD_V && MASK_ENABLE && !DEADV_LDS) {
                        // Psh receives exactly this FLOAT_TYPEV4, so testing the register is
                        // the same test the DEADV_LDS scan runs on the stored value.
                        [[unroll]] for (uint32_t vec_idx = 0; vec_idx < 4; ++vec_idx) {
                            if (fa_row_live(row + vec_idx) && float(Pf[vec_idx]) != 0.0f) {
                                p_dead_col[c] = false;
                            }
                        }
                    }
                }
            }
        }

        // Reduce the per-thread flags to one Bc-bit dead-column mask per row group.  Every
        // column of the tile is owned by exactly one lane of each subgroup
        // (col = c * cols_per_iter + col_tid, and cols_per_iter is the subgroup size - the
        // same assumption subgroupMax(rowmaxf) above already makes), so a subgroupAnd over
        // a mask each lane fills with 1s outside its own columns is that row group's
        // verdict.  Published before the barrier that already separates the Psh writes
        // above from the coopMatLoad(Psh) below, so this costs no barrier of its own.
        // The per-row-tile AND of these masks is taken after that barrier.
        if (ZERO_DEAD_V && MASK_ENABLE && !DEADV_LDS) {
            [[unroll]] for (uint32_t w = 0; w < dead_words; ++w) {
                // bits of columns that do not exist stay 0, so "mask != 0" means
                // "some real column of this tile is dead"
                uint32_t m = 0xFFFFFFFFu >> (32 - min(Bc - 32 * w, 32u));
                [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
                    const uint col = c * cols_per_iter + col_tid;
                    if (!p_dead_col[c] && col / 32 == w) {
                        m &= ~(1u << (col % 32));
                    }
                }
                m = subgroupAnd(m);
                if (gl_SubgroupInvocationID == 0) {
                    p_dead_sg[gl_SubgroupID * dead_words + w] = m;
                }
            }
        }

        if (SHMEM_STAGING != 0) {
            [[unroll]] for (uint32_t idx = 0; idx < Bc * HSV_pad / 4; idx += gl_WorkGroupSize.x) {
                uint32_t d = (idx + tid) % (HSV_pad / 4);
                uint32_t c = (idx + tid) / (HSV_pad / 4);
                if (idx + gl_WorkGroupSize.x <= Bc * HSV_pad / 4 || c < Bc) {
                    FLOAT_TYPEV4 V_Tf = FLOAT_TYPEV4(0);
                    if ((!KV_bounds_check || FA_KV_LIVE(j, c)) && (HSV == HSV_pad || d < HSV / 4)) {
#if !defined(BFLOAT16)
                        if (USE_DECODE_V) {
                            uint coord = FA_KV_ROW(j, c) * v_stride * BLOCK_SIZE_V + 4 * d;
                            uint ib = coord / BLOCK_SIZE_V;
                            uint iqs = (coord % BLOCK_SIZE_V);
                            V_Tf = dequantize4(ib, iqs, v_offset, BINDING_IDX_V);
                        } else
#endif
                        {
                            V_Tf = FLOAT_TYPEV4(data_vv4[v_offset / 4 + FA_KV_ROW(j, c) * v_stride / 4 + d]);
                        }
                    }

                    kvsh[c * kvsh_stride + d] = V_Tf;
                }
            }
        }
        barrier();

        // A KV column whose P entries are all zero contributes nothing to any row of a
        // coopmat row tile, so its V values may be replaced by +0 without changing that
        // tile's result.  Doing so is what makes the result independent of them: coopMatMulAdd
        // on RDNA3 is not invariant to the sign of a zero product (+0 * V == -0 for V < 0), so
        // a suppressed column with non-zero V perturbs the accumulator by one ULP.  See
        // ZERO_DEAD_V.
        //
        // Default path: AND the row-group verdicts published above.  A row tile's rows are
        // covered by MatBr / rows_per_thread consecutive row groups, so a column is dead for
        // that tile iff every one of those groups found all of its own rows zero - the same
        // "P == 0 for every live row of the tile" predicate the DEADV_LDS scan computes, and
        // at row_tiles == 1 the same Br-wide AND as before.  Workgroup-uniform: every thread
        // reads the same shared words.
        if (ZERO_DEAD_V && MASK_ENABLE && !DEADV_LDS) {
            const uint32_t sg_per_tile = MatBr / rows_per_thread;
            [[unroll]] for (uint32_t t = 0; t < row_tiles; ++t) {
                bool any = false;
                [[unroll]] for (uint32_t w = 0; w < dead_words; ++w) {
                    uint32_t m = p_dead_sg[t * sg_per_tile * dead_words + w];
                    [[unroll]] for (uint32_t g = 1; g < sg_per_tile; ++g) {
                        m &= p_dead_sg[(t * sg_per_tile + g) * dead_words + w];
                    }
                    dead_cols[t * dead_words + w] = m;
                    any = any || (m != 0);
                }
                any_dead_tile[t] = any;
            }
        }

        // A/B path: rebuild the same masks by re-reading Psh, behind two extra barriers.
        if (ZERO_DEAD_V && MASK_ENABLE && DEADV_LDS) {
            if (tid < row_tiles * dead_words) {
                p_dead_lds[tid] = 0;
            }
            barrier();
            [[unroll]] for (uint32_t idx = 0; idx < Bc; idx += gl_WorkGroupSize.x) {
                const uint32_t c = idx + tid;
                if (c < Bc) {
                    [[unroll]] for (uint32_t t = 0; t < row_tiles; ++t) {
                        bool dead = true;
                        for (uint32_t r = t * MatBr; r < (t + 1) * MatBr; ++r) {
                            if (fa_row_live(r)) {
                                dead = dead && float(Psh[c * psh_stride + r / 4][r % 4]) == 0.0f;
                            }
                        }
                        if (dead) {
                            atomicOr(p_dead_lds[t * dead_words + c / 32], 1u << (c % 32));
                        }
                    }
                }
            }
            barrier();
            [[unroll]] for (uint32_t t = 0; t < row_tiles; ++t) {
                bool any = false;
                [[unroll]] for (uint32_t w = 0; w < dead_words; ++w) {
                    const uint32_t m = p_dead_lds[t * dead_words + w];
                    dead_cols[t * dead_words + w] = m;
                    any = any || (m != 0);
                }
                any_dead_tile[t] = any;
            }
        }

        // A row tile entirely past the end of the batch has no output worth protecting, and
        // marking all of its columns dead would force a V staging pass on every KV tile of
        // the last query tile.  A row tile's rows belong to one token (token-aligned packing),
        // so its first row is live iff any of them is.  Unreachable at row_tiles == 1.
        [[unroll]] for (uint32_t t = 1; t < row_tiles; ++t) {
            if (ZERO_DEAD_V && MASK_ENABLE && !fa_row_live(t * MatBr)) {
                [[unroll]] for (uint32_t w = 0; w < dead_words; ++w) {
                    dead_cols[t * dead_words + w] = 0;
                }
                any_dead_tile[t] = false;
            }
        }

        // When the row tiles disagree about which columns are dead, V is staged once per row
        // tile so each tile still sees exactly the +0 columns it would have seen on its own -
        // that is what keeps a query row's P*V chain identical to its Br == MatBr chain.  The
        // extra pass costs a second kvsh fill and two barriers, and only on the KV tiles where
        // the row tiles actually disagree: with a causal mask that is the ~2 tiles per query
        // tile that straddle the diagonal.  Workgroup-uniform.  The whole-tile SHMEM_STAGING
        // path does no dead-column replacement at all, so it never splits.
        bool dead_split = false;
        if (ZERO_DEAD_V && MASK_ENABLE && SHMEM_STAGING == 0) {
            [[unroll]] for (uint32_t t = 1; t < row_tiles; ++t) {
                [[unroll]] for (uint32_t w = 0; w < dead_words; ++w) {
                    dead_split = dead_split || (dead_cols[t * dead_words + w] != dead_cols[w]);
                }
            }
        }

        const uint num_hsv_tiles = (HSV + MatBc * row_split - 1) / (MatBc * row_split); // round up

        // Each subgroup handles HSV/4 columns
        [[unroll]] for (uint32_t hsv_tile = 0; hsv_tile < num_hsv_tiles; ++hsv_tile) {
            const uint hsv_offset = (hsv_tile * row_split + gl_SubgroupID) * 16;

            coopmat<O_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator> PVMat0 = coopmat<O_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator>(0);
            coopmat<O_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator> PVMat1 = coopmat<O_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator>(0);

            const uint o_offset = gl_SubgroupID * MatBr / 4;

            if (!dead_split) {
                // Preload V tiles for [Bc, 16 * num subgroups].
                // If SHMEM_STAGING is set, a Bc * HSV_pad size tile of V is loaded to shmem.
                // If not, V is loaded directly from global memory if aligned, otherwise
                // staged through a Bc * MatBr size staging buffer.
                // If V is a quant type, then it is always staged for dequantization.
                // For quants we always preload via kvsh. For f16/bf16 we only preload when
                // alignment / bounds force it, or when this Bc tile has mask-suppressed columns
                // whose V has to be replaced by +0 (ZERO_DEAD_V).
                const bool stage_v = USE_DECODE_V || KV_bounds_check ||
                                     (ZERO_DEAD_V && MASK_ENABLE && any_dead_tile[0]);
                if (SHMEM_STAGING == 0 && stage_v && !V_CHUNK) {
                    stage_v_columns(j, hsv_tile, v_offset, tid, 0, ZERO_DEAD_V && MASK_ENABLE);
                }
                barrier();

                if (V_CHUNK) {
                    // [TAG_FA1] the same bc_chunk order and operands as below, V staged per chunk when staged at all.
                    // The barriers sit outside the subgroup-dependent hsv_offset test, so they are workgroup-uniform.
                    [[unroll]] for (uint32_t bc_chunk = 0; bc_chunk < Bc / MatBc; ++bc_chunk) {
                        if (stage_v) {
                            if (bc_chunk > 0) {
                                barrier(); // the previous chunk's kvsh reads
                            }
                            stage_v_chunk(j, hsv_tile, bc_chunk, v_offset, tid, ZERO_DEAD_V && MASK_ENABLE);
                            barrier();
                        }
                        if (hsv_offset < HSV_pad) {
                            if (stage_v) {
                                coopMatLoad(QMat, kvsh, gl_SubgroupID * (MatBc / 4), vsh_stride, gl_CooperativeMatrixLayoutRowMajor);
                            } else {
                                const uint v_tile_row = j * Bc + bc_chunk * MatBc;
                                const uint v_tile_offset = v_offset / 4 + v_tile_row * v_stride / 4 + hsv_offset / 4;
                                coopMatLoad(QMat, data_vv4, v_tile_offset, v_stride / 4, gl_CooperativeMatrixLayoutRowMajor);
                            }
                            coopMatLoad(KMat, Psh, bc_chunk * MatBc * psh_stride, psh_stride, gl_CooperativeMatrixLayoutColumnMajor);
                            PVMat0 = coopMatMulAdd(KMat, QMat, PVMat0);
                        }
                    }
                } else if (hsv_offset < HSV_pad) {
                    [[unroll]] for (uint32_t bc_chunk = 0; bc_chunk < Bc / MatBc; ++bc_chunk) {
                        FA_LOAD_V_TILE(stage_v)

                        // One V operand, one accumulator per row tile: each row tile sums the
                        // same bc_chunk order into its own PVMat.
                        coopMatLoad(KMat, Psh, bc_chunk * MatBc * psh_stride, psh_stride, gl_CooperativeMatrixLayoutColumnMajor);
                        PVMat0 = coopMatMulAdd(KMat, QMat, PVMat0);

                        if (row_tiles > 1) {
                            coopMatLoad(KMat, Psh, bc_chunk * MatBc * psh_stride + MatBr / 4, psh_stride, gl_CooperativeMatrixLayoutColumnMajor);
                            PVMat1 = coopMatMulAdd(KMat, QMat, PVMat1);
                        }
                    }
                }
            } else {
                // Split path, only reachable when row_tiles > 1 and the tiles disagree.
                const uint32_t t1 = row_tiles - 1;

                const bool stage_v0 = USE_DECODE_V || KV_bounds_check || any_dead_tile[0];
                if (stage_v0) {
                    stage_v_columns(j, hsv_tile, v_offset, tid, 0, true);
                }
                barrier();
                if (hsv_offset < HSV_pad) {
                    [[unroll]] for (uint32_t bc_chunk = 0; bc_chunk < Bc / MatBc; ++bc_chunk) {
                        FA_LOAD_V_TILE(stage_v0)
                        coopMatLoad(KMat, Psh, bc_chunk * MatBc * psh_stride, psh_stride, gl_CooperativeMatrixLayoutColumnMajor);
                        PVMat0 = coopMatMulAdd(KMat, QMat, PVMat0);
                    }
                }
                barrier();

                const bool stage_v1 = USE_DECODE_V || KV_bounds_check || any_dead_tile[t1];
                if (stage_v1) {
                    stage_v_columns(j, hsv_tile, v_offset, tid, t1, true);
                }
                barrier();
                if (hsv_offset < HSV_pad) {
                    [[unroll]] for (uint32_t bc_chunk = 0; bc_chunk < Bc / MatBc; ++bc_chunk) {
                        FA_LOAD_V_TILE(stage_v1)
                        coopMatLoad(KMat, Psh, bc_chunk * MatBc * psh_stride + t1 * MatBr / 4, psh_stride, gl_CooperativeMatrixLayoutColumnMajor);
                        PVMat1 = coopMatMulAdd(KMat, QMat, PVMat1);
                    }
                }
                barrier();
            }

            if (hsv_offset < HSV_pad) {
                // Store PVMat to pvsh and load into Of
                if (SFPV_ALIAS) {
                    coopMatStore(PVMat0, sfsh, o_offset, osh_stride, gl_CooperativeMatrixLayoutRowMajor);
                    if (row_tiles > 1) {
                        coopMatStore(PVMat1, sfsh, MatBc * osh_stride + o_offset, osh_stride, gl_CooperativeMatrixLayoutRowMajor);
                    }
                } else {
                    coopMatStore(PVMat0, pvsh, o_offset, osh_stride, gl_CooperativeMatrixLayoutRowMajor);
                    if (row_tiles > 1) {
                        coopMatStore(PVMat1, pvsh, MatBc * osh_stride + o_offset, osh_stride, gl_CooperativeMatrixLayoutRowMajor);
                    }
                }
            }

            barrier();

            const uint hsv_per_tile = row_split * MatBc;
            const uint hsv_base = hsv_tile * hsv_per_tile;
            const uint d_values_per_tile = hsv_per_tile / 4;

            const uint d_start = hsv_tile * d_values_per_tile;
            const uint d_end = min(d_start + d_values_per_tile, HSV / 4);

            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                const uint row = tile_row(r);

                [[unroll]] for (uint32_t d_local = 0; d_local < d_per_thread; ++d_local) {
                    const uint d = d_local * threads_per_rowgroup + col_tid;
                    const uint hsv_col = 4 * d;

                    if (hsv_col >= hsv_base && hsv_col < hsv_base + hsv_per_tile && hsv_col < HSV) {
                        const uint local_hsv = (hsv_col - hsv_base) / 4;
                        Of[r][d_local] += SFPV_ALIAS ? sfsh[row * osh_stride + local_hsv] : pvsh[row * osh_stride + local_hsv];
                    }
                }
            }
        }

        barrier();
    }

    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        Lf[r] = subgroupAdd(Lf[r]);
    }

    // If there is split_k, then the split_k resolve shader does the final
    // division by L. Store the intermediate O value and per-row m and L values.
    if (p.k_num > 1) {
        if (GQA_TOKENS) {
            // Each row carries its own token, so the split_k slice it belongs to
            // ([HSV, ne1, k, ne2, ne3], and [ne1, k, ne2, ne3] for L/M) is per row.
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                const uint32_t grow = i * Br + tile_row(r);
                if (fa_row_live(tile_row(r))) {
                    const uint32_t tok = FA_ROW_TOKEN(grow);
                    const uint32_t hd  = FA_ROW_HEAD(grow);

                    const uint32_t o_offset = HSV * p.ne1 * (split_k_index + p.k_num * (tok + p.ne2 * iq3)) / 4;
                    [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                        const uint d = d0 + col_tid;
                        if (d >= HSV/4) break;
                        const uint d_local = d0 / threads_per_rowgroup;
                        gqaStore(hd, d, Of[r][d_local], o_offset, iq2, N);
                    }

                    const uint32_t lm_offset = HSV * p.ne1 * p.k_num * p.ne2 * p.ne3 + p.ne1 * 2 * (split_k_index + p.k_num * (tok + p.ne2 * iq3));
                    perElemOpStoreCol0(hd, 0u, ACC_TYPE(Lf[r]), lm_offset, iq2, N);
                    perElemOpStoreCol0(hd, 0u, ACC_TYPE(Mf[r]), lm_offset + p.ne1, iq2, N);
                }
            }
        } else if (p.gqa_ratio > 1) {
            // note: O and Q have swapped coord 1,2.
            uint32_t o_offset = HSV * p.ne1 * (split_k_index + p.k_num * (gqa_iq1 + p.ne2 * iq3)) / 4;

            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                if (tile_row(r) < N) {
                    [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                        const uint d = d0 + col_tid;
                        if (d >= HSV/4) break;
                        const uint d_local = d0 / threads_per_rowgroup;
                        gqaStore(tile_row(r), d, Of[r][d_local], o_offset, iq2, N);
                    }
                }
            }

            o_offset = HSV * p.ne1 * p.k_num * p.ne2 * p.ne3 + p.ne1 * 2 * (split_k_index + p.k_num * (gqa_iq1 + p.ne2 * iq3));
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                if (tile_row(r) < N) {
                    perElemOpStoreCol0(tile_row(r), 0u, ACC_TYPE(Lf[r]), o_offset, iq2, N);
                    perElemOpStoreCol0(tile_row(r), 0u, ACC_TYPE(Mf[r]), o_offset + p.ne1, iq2, N);
                }
            }
        } else {
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                const uint row = tile_row(r);
                const uint global_row = i * Br + row;

                if (global_row < N) {
                    uint32_t o_offset = HSV * p.ne1 * (split_k_index + p.k_num * (global_row + p.ne2 * iq3)) / 4;

                    [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                        const uint d = d0 + col_tid;
                        if (d >= HSV/4) break;
                        data_ov4[o_offset + iq2 * HSV/4 + d] = D_TYPEV4(Of[r][d/threads_per_rowgroup]);
                    }
                }

                if (global_row < N && col_tid == 0) {
                    uint32_t lm_offset = HSV * p.ne1 * p.k_num * p.ne2 * p.ne3 + p.ne1 * 2 * (split_k_index + p.k_num * (global_row + p.ne2 * iq3));
                    data_o[lm_offset + iq2] = D_TYPE(Lf[r]);
                    data_o[lm_offset + p.ne1 + iq2] = D_TYPE(Mf[r]);
                }
            }
        }

        return;
    }

    if ((p.mask_n_head_log2 & SINK_ENABLE_BIT) != 0) {
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            float sink = perElemOpGetSink(GQA_TOKENS ? (i * Br + tile_row(r)) : tile_row(r), 0u, ACC_TYPE(0), iq2);

            float ms = 1.0f;
            float vs = 1.0f;

            if (sink > Mf[r]) {
                ms = exp(Mf[r] - sink);

                [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                    const uint d_local = d0 / threads_per_rowgroup;
                    Of[r][d_local] *= O_TYPE(ms);
                }
            } else {
                vs = exp(sink - Mf[r]);
            }

            Lf[r] = Lf[r]*ms + vs;
        }
    }

    float Lfrcp[rows_per_thread];
    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        Lfrcp[r] = (Lf[r] == 0.0) ? 0.0 : (1.0 / Lf[r]);
    }

    [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
        const uint d_local = d0 / threads_per_rowgroup;
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            Of[r][d_local] *= O_TYPE(Lfrcp[r]);
#if defined(FLOAT_TYPE_MAX)
            Of[r][d_local] = clamp(Of[r][d_local], O_TYPEV4(-FLOAT_TYPE_MAX), O_TYPEV4(FLOAT_TYPE_MAX));
#endif
        }
    }

    uint32_t o_offset = (gqa_iq1*p.ne1*HSV + iq3*p.ne2*p.ne1*HSV) / 4;

    if (GQA_TOKENS) {
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            const uint32_t grow = i * Br + tile_row(r);
            if (fa_row_live(tile_row(r))) {
                const uint32_t row_o_offset = (FA_ROW_TOKEN(grow)*p.ne1*HSV + iq3*p.ne2*p.ne1*HSV) / 4;
                const uint32_t hd = FA_ROW_HEAD(grow);
                [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                    const uint d = d0 + col_tid;
                    if (d >= HSV / 4) break;
                    const uint d_local = d0 / threads_per_rowgroup;
                    gqaStore(hd, d, Of[r][d_local], row_o_offset, iq2, N);
                }
            }
        }
    } else if (p.gqa_ratio > 1) {
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            if (tile_row(r) < N) {
                [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                    const uint d = d0 + col_tid;
                    if (d >= HSV / 4) break;
                    const uint d_local = d0 / threads_per_rowgroup;
                    gqaStore(tile_row(r), d, Of[r][d_local], o_offset, iq2, N);
                }
            }
        }
    } else {
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            if (i * Br + tile_row(r) < N) {
                [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                    const uint d = d0 + col_tid;
                    if (d >= HSV / 4) break;
                    const uint d_local = d0 / threads_per_rowgroup;
                    data_ov4[o_offset + (iq2 * HSV + (i * Br + tile_row(r)) * p.ne1 * HSV) / 4 + d] = D_TYPEV4(Of[r][d_local]);
                }
            }
        }
    }
}
