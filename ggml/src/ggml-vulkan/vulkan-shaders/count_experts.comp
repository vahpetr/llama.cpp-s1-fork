#version 450

#extension GL_EXT_control_flow_attributes : enable

#ifdef USE_SUBGROUPS
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#endif

#include "types.glsl"

layout (push_constant) uniform parameter
{
    uint32_t ne00;
    uint32_t ne01;
    uint32_t nb00;
    uint32_t nb01;
    uint32_t a_offset;
    uint32_t n_experts;
    uint32_t hoist_row_ids;
    uint32_t ne00mp;
    uint32_t ne00L;
    uint32_t tile_bn;
} p;

#define BLOCK_SIZE 256

layout(local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;

// Upper bound on p.n_experts for the hoisting path: vals/offsets/cursors are indexed by
// expert id, so they cost N_EXPERTS_MAX * 3 * 4 B of shared memory (6 KiB at 512, well under
// the 16 KiB every Vulkan implementation must provide).  The host picks the value (see
// ggml-vulkan.cpp, vk_count_experts_max_experts) and turns hoisting off for larger n_as.
// Must be >= BLOCK_SIZE: vals[] doubles as the reduction scratch of the non-hoisted path.
//
// Two pipelines are built from this module: the plain counting one is specialized to BLOCK_SIZE
// (3 KiB, the upstream footprint) and never takes the p.hoist_row_ids branch; the hoisting one is
// specialized to vk_count_experts_max_experts.  So the larger allocation is paid only where it is
// used, and a dispatch that only counts keeps its old occupancy.
layout (constant_id = 0) const uint N_EXPERTS_MAX = BLOCK_SIZE;

layout (binding = 0) readonly buffer A {uint data_a[];};
layout (binding = 1) writeonly buffer D {uint data_d[];};

shared uint vals[N_EXPERTS_MAX];
shared uint offsets[N_EXPERTS_MAX];
shared uint cursors[N_EXPERTS_MAX];

// see init_fastdiv_values in ggml-vulkan.cpp
uint fastdiv(uint n, uint mp, uint L) {
    uint msbs, lsbs;
    // msbs = mulhi(n, mp)
    umulExtended(n, mp, msbs, lsbs);
    return (msbs + n) >> L;
}

// data_d layout when p.hoist_row_ids is set:
//   [0,              n_experts)   per-expert row count
//   [n_experts,    2*n_experts)   per-expert start offset into the row id region
//   [2*n_experts]                 total row count
//   [2*n_experts + 1,         )   row ids grouped by expert, packed as (i01 << 16) | (i00 & 0xffff)
// Otherwise only data_d[expert_id] is written, holding that expert's row count.
//
// [TAG_MMID_HOIST_CHUNKED] (port of upstream #29998, 966baae76) p.n_experts may exceed N_EXPERTS_MAX:
// the hoisting branch walks the experts in chunks of N_EXPERTS_MAX (one count / prefix / scatter round
// per chunk over the same shared arrays), carrying the running row and tile totals across chunks.  For
// n_experts <= N_EXPERTS_MAX it is a single round, the pre-port program.  A row id lands at
// offsets[e] + its atomicAdd cursor either way, so the layout above does not depend on the chunking.
//
// [TAG_MMID_COMPACT] When p.tile_bn is also non-zero a third region follows the row id region.
// The row id region is addressed from a fixed base and is at most ne00*ne01 words long (one packed
// row id per (expert slot, token)), so the third region starts at a host-computable
//   T = 2*n_experts + 1 + ne00*ne01
// and holds the compact list of the (expert, N-tile) pairs that have rows, for a tile width of
// p.tile_bn (the #29998 tile list; this fork keeps the contiguous row id region above and lists
// (expert, ic) pairs instead of upstream's (expert, valid rows) on a tile-aligned row region):
//   [T]                 the tile count, sum over all e of ceil(count[e] / tile_bn)
//   [T + 1 + 2*t]       the expert of tile t
//   [T + 2 + 2*t]       its N-tile index ic (rows ic*tile_bn .. of that expert)
// Tiles are listed expert-major, ic ascending.  mul_mm.comp / mul_mmq.comp / mul_mmq_cm1.comp /
// mul_mm_cm2.comp read entry t for flat workgroup t and return at once for t >= [T], which lets the
// host dispatch a bound on sum_e ceil(count_e / BN) tiles instead of n_experts * ceil(nei1 / BN).
// It is appended *after* the row ids on purpose: the header and the row id region keep
// byte-identical contents and addressing either way, so turning the compact grid on cannot move a
// single row id.
void write_tiles(const uint tile_base, const uint expert, const uint count, const uint tile_begin) {
    const uint n_tiles = (count + p.tile_bn - 1) / p.tile_bn;
    for (uint t = 0; t < n_tiles; ++t) {
        data_d[tile_base + 1 + 2 * (tile_begin + t)]     = expert;
        data_d[tile_base + 1 + 2 * (tile_begin + t) + 1] = t;
    }
}

void main() {
    const uint expert_id = gl_WorkGroupID.x;
    const uint num_elements = p.ne00 * p.ne01;
    const uint tid = gl_LocalInvocationID.x;

    if (p.hoist_row_ids != 0) {
        const uint tile_base = 2 * p.n_experts + 1 + num_elements;
        // running totals over the chunks done so far; meaningful in the lanes that run the prefix
        // (subgroup 0, or invocation 0 without subgroups), uniform across subgroup 0
        uint total_rows = 0;
        uint total_tiles = 0;

        for (uint expert_base = 0; expert_base < p.n_experts; expert_base += N_EXPERTS_MAX) {
            const uint n_chunk = min(N_EXPERTS_MAX, p.n_experts - expert_base);

            // n_chunk may exceed the workgroup size (e.g. 512 experts, 256 threads), so stride.
            for (uint e = tid; e < n_chunk; e += BLOCK_SIZE) {
                vals[e] = 0;
            }
            barrier();

            for (uint idx = tid; idx < num_elements; idx += BLOCK_SIZE) {
                const uint i01 = fastdiv(idx, p.ne00mp, p.ne00L);
                const uint i00 = idx - i01 * p.ne00;
                const uint e = data_a[p.a_offset + i01 * p.nb01 + i00 * p.nb00] - expert_base;
                if (e < n_chunk) {
                    atomicAdd(vals[e], 1);
                }
            }
            barrier();

#ifdef USE_SUBGROUPS
            if (gl_SubgroupID == 0) {
                // pad the trip count so the subgroup ops stay in uniform control flow
                const uint n_chunk_padded = (n_chunk + gl_SubgroupSize - 1) & ~(gl_SubgroupSize - 1);
                uint base = total_rows;
                for (uint e = gl_SubgroupInvocationID; e < n_chunk_padded; e += gl_SubgroupSize) {
                    const bool in_range = e < n_chunk;
                    const uint count = in_range ? vals[e] : 0;
                    const uint offset = base + subgroupExclusiveAdd(count);
                    if (in_range) {
                        data_d[expert_base + e] = count;
                        data_d[p.n_experts + expert_base + e] = offset;
                        offsets[e] = offset;
                        cursors[e] = 0;
                    }
                    base += subgroupAdd(count);
                }
                total_rows = base;
                // [TAG_MMID_COMPACT] second pass over the same vals[]: the tile list.  Same trip
                // count and the same uniform control flow as the loop above; p.tile_bn is a push
                // constant, so the branch is uniform across the dispatch.
                if (p.tile_bn != 0) {
                    uint tiles = total_tiles;
                    for (uint e = gl_SubgroupInvocationID; e < n_chunk_padded; e += gl_SubgroupSize) {
                        const bool in_range = e < n_chunk;
                        const uint expert_tiles = in_range ? (vals[e] + p.tile_bn - 1) / p.tile_bn : 0;
                        const uint tile_begin = tiles + subgroupExclusiveAdd(expert_tiles);
                        if (in_range) {
                            write_tiles(tile_base, expert_base + e, vals[e], tile_begin);
                        }
                        tiles += subgroupAdd(expert_tiles);
                    }
                    total_tiles = tiles;
                }
            }
#else
            if (tid == 0) {
                for (uint e = 0; e < n_chunk; ++e) {
                    const uint count = vals[e];
                    data_d[expert_base + e] = count;
                    data_d[p.n_experts + expert_base + e] = total_rows;
                    offsets[e] = total_rows;
                    cursors[e] = 0;
                    total_rows += count;
                    // [TAG_MMID_COMPACT] see the subgroup branch above.
                    if (p.tile_bn != 0) {
                        write_tiles(tile_base, expert_base + e, count, total_tiles);
                        total_tiles += (count + p.tile_bn - 1) / p.tile_bn;
                    }
                }
            }
#endif
            barrier();

            for (uint idx = tid; idx < num_elements; idx += BLOCK_SIZE) {
                const uint i01 = fastdiv(idx, p.ne00mp, p.ne00L);
                const uint i00 = idx - i01 * p.ne00;
                const uint e = data_a[p.a_offset + i01 * p.nb01 + i00 * p.nb00] - expert_base;
                if (e < n_chunk) {
                    const uint row = atomicAdd(cursors[e], 1);
                    const uint packed_row_id = (i01 << 16) | (i00 & 0xffffu);
                    data_d[2 * p.n_experts + 1 + offsets[e] + row] = packed_row_id;
                }
            }
            // the next chunk overwrites vals / offsets / cursors
            barrier();
        }

#ifdef USE_SUBGROUPS
        if (gl_SubgroupID == 0 && subgroupElect()) {
#else
        if (tid == 0) {
#endif
            data_d[2 * p.n_experts] = total_rows;
            if (p.tile_bn != 0) {
                data_d[tile_base] = total_tiles;
            }
        }
        return;
    }

    uint count = 0;
    for (uint idx = tid; idx < num_elements; idx += BLOCK_SIZE) {
        const uint i01 = fastdiv(idx, p.ne00mp, p.ne00L);
        const uint i00 = idx - i01 * p.ne00;
        const uint a = data_a[p.a_offset + i01 * p.nb01 + i00 * p.nb00];

        count += uint(a == expert_id);
    }

    vals[tid] = count;
    barrier();
    [[unroll]] for (uint s = BLOCK_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            vals[tid] += vals[tid + s];
        }
        barrier();
    }

    if (tid == 0) {
        data_d[expert_id] = vals[0];
    }
}
