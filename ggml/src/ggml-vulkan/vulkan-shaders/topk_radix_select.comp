#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
// [TAG_QSA_SCRATCH_COHERENT] The QSA path publishes the gathered row in `scratch` (binding 4) from
// one invocation and reads it back in others: the radix passes keep the strided element ->
// invocation map of the pass that wrote it, but the emit phase re-partitions the row into
// contiguous ranges, so nearly every entry it reads was written by a different invocation. Under
// the default GLSL memory model `barrier()` orders shared memory and `memoryBarrierBuffer()` is a
// bare availability/visibility operation whose pairing with the execution barrier is exactly the
// under-specified corner the Vulkan memory model exists to pin down - "it happens to work on this
// driver" is not a guarantee, and the failure mode (a stale scratch entry) is a wrong selection,
// not a crash. Use the house idiom instead - argsort_large.comp publishes its bitonic scratch the
// same way: the Vulkan memory model, `workgroupcoherent` on the buffer that crosses invocations,
// and a controlBarrier carrying buffer storage semantics at the publish point.
#extension GL_KHR_memory_scope_semantics : enable
#pragma use_vulkan_memory_model

#include "types.glsl"

layout(constant_id = 0) const int BLOCK_SIZE = 1024;
// 1: fuse the qwen4 QSA indexer gather + f16 mask; 2: [TAG_QSA_WHOLE_BLOCKS] the block-level form
// (ggml_qsa_top_k_blocks: n_sel whole blocks + the boosted tail, ascending ids, padded - see topk_blocks)
layout(constant_id = 1) const int QSA = 0;

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A  {float     data_a[];};   // input values, or QSA block scores (strides in sb_blk/sb_tps)
layout (binding = 1) writeonly buffer D {int       data_d[];};   // [k, ...]
layout (binding = 2) readonly buffer CB {int       cell_blk[];}; // QSA: cell->block map [n_kv, n_stream]
#ifdef QSA_VIS
// [TAG_QSA_VIS] (A4 T3, ggml_qsa_top_k_vis) the mask computed from the visibility metadata instead of read from a plane:
// binding 3 holds the cell planes [n_kv, 4, n_stream] (I32), binding 5 the token records [4, n_tps, n_stream] of the
// rows; qsa_vis_mask() is the f16 plane's element as a float (+0 or -inf, see kq_vis.glsl), so every `a + m` below
// is the plane form's add on the same value
layout(constant_id = 2) const uint VIS_CAUSAL = 1;
layout (binding = 3) readonly buffer VC {int   data_vc[];};
layout (binding = 5) readonly buffer VT {ivec4 data_vt[];};
#else
layout (binding = 3) readonly buffer M  {float16_t mask[];};     // QSA: raw f16 kq_mask [n_kv, n_tps, n_stream]
#endif
// workgroupcoherent: written by one invocation, read by others of the same workgroup (see
// [TAG_QSA_SCRATCH_COHERENT]). Never shared between workgroups - one workgroup owns a row.
layout (binding = 4) workgroupcoherent buffer S {float scratch[];};  // QSA: [nrows, n_kv] gathered inputs

layout (push_constant) uniform parameter {
    uint ncols;
    uint k;
    uint nrows;
    uint n_tps;    // QSA only
    uint n_blocks; // QSA only
    uint n_stream; // QSA only
    // QSA only: the score operand's element strides along the block and the token axis. One shader
    // serves both callers: the seven-node fusion hands it cont(permute(score)) - [n_tps, n_blocks,
    // n_stream], so sb_blk = n_tps and sb_tps = 1 - while GGML_OP_QSA_TOP_K hands it the score in
    // its natural [n_blocks, n_tps, n_stream] layout - sb_blk = 1, sb_tps = n_blocks - and skips
    // the permute+cont entirely. The stream stride is n_blocks*n_tps either way.
    uint sb_blk;   // QSA only
    uint sb_tps;   // QSA only
    uint n_sel;    // QSA == 2 only: the number of whole blocks to select
} p;

#ifdef QSA_VIS
int kqv_cell_load(uint idx) {
    return data_vc[idx];
}

#include "kq_vis.glsl"

// the mask element of cell i for row t of stream s (the plane's mask[(s * p.n_tps + t) * p.ncols + i])
float qsa_vis_mask(uint s, uint t, uint i) {
    return kqv_value(s * 4u * p.ncols, p.ncols, i, data_vt[s * p.n_tps + t],
                     (VIS_CAUSAL != 0u ? KQV_FLAG_CAUSAL : 0u) | KQV_FLAG_F16, 0);
}
#endif

// [TAG_QSA_WHOLE_BLOCKS] GGML_QSA_TAIL_MIN (ggml.h): 5e8 = 15625000 * 2^5, exact in f32
const float QSA_TAIL_MIN = 5.0e8;

#define RADIX_BITS 8
#define RADIX_SIZE (1 << RADIX_BITS)

shared uint histo[RADIX_SIZE];
shared uint sh_bucket;
shared uint sh_above;
// per-invocation counts of the two output classes, scanned in place (see topk)
shared uint sh_gt[BLOCK_SIZE];
shared uint sh_eq[BLOCK_SIZE];
// [TAG_QSA_WHOLE_BLOCKS] the last (largest) selected cell id of the row: the padding value
shared uint sh_last;

// order-preserving float -> uint mapping. -0.0 is folded onto +0.0 first: its bit pattern
// sorts strictly below +0.0, but IEEE compare - and therefore the CPU reference - calls the
// two equal, and now that ties are resolved by index the difference is observable in the
// selected SET whenever the threshold value is zero.
uint f2ui(float x) {
    uint y = floatBitsToUint(x);
    if (y == 0x80000000u) {
        y = 0u;
    }
    if ((y & 0x80000000u) != 0u) {
        y ^= 0xFFFFFFFFu;
    } else {
        y |= 0x80000000u;
    }
    return y;
}

// QSA element i of row (t,s): score[cell_blk[i,s], t, s] + mask[i,t,s]
float gather(uint row, uint i) {
    const uint t = row % p.n_tps;
    const uint s = row / p.n_tps;
    const uint block = uint(cell_blk[s * p.ncols + i]);
    const float a = data_a[s * p.n_blocks * p.n_tps + block * p.sb_blk + t * p.sb_tps];
#ifdef QSA_VIS
    const float m = qsa_vis_mask(s, t, i);
#else
    const float m = float(mask[(s * p.n_tps + t) * p.ncols + i]);
#endif
    return a + m;
}

float load(uint row, uint i, bool first) {
    if (QSA == 0) {
        return data_a[row * p.ncols + i];
    }
    // materialize the scattered gather on the first pass and reuse it after. The radix
    // passes keep the same strided element->invocation map as the pass that wrote it, so
    // they read their own entries; the emit phase below re-partitions the row and must
    // publish the writes first (controlBarrier with buffer semantics, [TAG_QSA_SCRATCH_COHERENT]).
    const uint off = row * p.ncols + i;
    if (first) {
        const float v = gather(row, i);
        scratch[off] = v;
        return v;
    }
    return scratch[off];
}

// one workgroup per row: radix-select the K-th largest, then compact it plus the lowest-index ties
void topk(const uint row) {
    const uint tid = gl_LocalInvocationID.x;
    const uint ncols = p.ncols;
    const uint row_out = row * p.k;

    uint prefix  = 0;     // fixed high bits of the threshold key
    uint desired = p.k;   // count still needed from the candidate range

    [[unroll]] for (int shift = 32 - RADIX_BITS; shift >= 0; shift -= RADIX_BITS) {
        for (uint i = tid; i < RADIX_SIZE; i += BLOCK_SIZE) {
            histo[i] = 0;
        }
        barrier();

        const bool first     = (shift == 32 - RADIX_BITS);
        const uint hi_mask   = (shift + RADIX_BITS >= 32) ? 0u : (0xFFFFFFFFu << uint(shift + RADIX_BITS));
        const uint prefix_hi = prefix & hi_mask;
        for (uint i = tid; i < ncols; i += BLOCK_SIZE) {
            const uint key = f2ui(load(row, i, first));
            if ((key & hi_mask) == prefix_hi) {
                atomicAdd(histo[(key >> uint(shift)) & (RADIX_SIZE - 1)], 1u);
            }
        }
        barrier();

        // top-down scan for the bucket holding the K-th value
        if (tid == 0) {
            uint acc = 0;
            uint b   = 0;
            for (int bb = RADIX_SIZE - 1; bb >= 0; --bb) {
                const uint c = histo[bb];
                if (acc + c >= desired) { b = uint(bb); break; }
                acc += c;
            }
            sh_bucket = b;
            sh_above  = acc;
        }
        barrier();

        prefix  |= sh_bucket << uint(shift);
        desired -= sh_above;
        barrier();
    }

    // Emit. `threshold` is the key of the k-th largest element and `desired` is how many of
    // the elements EQUAL to it the row still needs, so `k - desired` elements are strictly
    // above it and all of them are selected. Which ties fill the rest is a real choice: pick
    // the lowest indices, which is what the CPU reference selects (it sorts by value
    // descending, index ascending), so the two agree element for element.
    //
    // The rank of an element within its class is computed instead of raced for: the row is
    // split into BLOCK_SIZE contiguous ranges, one per invocation, and a prefix sum over the
    // per-range counts turns "how many of my class come before my range" into "where my range
    // starts". Both classes share the scan's barriers. Nothing here is order-dependent, so
    // the ids are a pure function of the input - including their order, which the QSA gather
    // path needs: it sums the attention window in id order.
    const uint threshold = prefix;
    const uint n_above   = p.k - desired;

    // contiguous ranges, balanced to +-1 element; tid*quot cannot overflow (it is <= ncols)
    const uint quot = ncols / uint(BLOCK_SIZE);
    const uint rem  = ncols % uint(BLOCK_SIZE);
    const uint lo   = tid*quot + min(tid, rem);
    const uint hi   = lo + quot + (tid < rem ? 1u : 0u);

    if (QSA != 0) {
        // The ranges cross the strided map the radix passes used, so this is the first read of
        // scratch entries another invocation wrote - publish them. QSA is a specialization
        // constant, so this branch is uniform over the workgroup and a controlBarrier is legal
        // here. [TAG_QSA_SCRATCH_COHERENT]
        controlBarrier(gl_ScopeWorkgroup, gl_ScopeWorkgroup, gl_StorageSemanticsBuffer, gl_SemanticsAcquireRelease);
    }
    barrier();

    uint cnt_gt = 0;
    uint cnt_eq = 0;
    for (uint i = lo; i < hi; ++i) {
        const uint key = f2ui(load(row, i, false));
        cnt_gt += key >  threshold ? 1u : 0u;
        cnt_eq += key == threshold ? 1u : 0u;
    }
    sh_gt[tid] = cnt_gt;
    sh_eq[tid] = cnt_eq;
    barrier();

    for (uint d = 1; d < uint(BLOCK_SIZE); d <<= 1) {
        uint add_gt = 0;
        uint add_eq = 0;
        if (tid >= d) {
            add_gt = sh_gt[tid - d];
            add_eq = sh_eq[tid - d];
        }
        barrier();
        sh_gt[tid] += add_gt;
        sh_eq[tid] += add_eq;
        barrier();
    }

    // exclusive prefix: where this range's first element of each class lands
    uint pos_gt = tid == 0 ? 0 : sh_gt[tid - 1];
    uint pos_eq = tid == 0 ? 0 : sh_eq[tid - 1];

    for (uint i = lo; i < hi; ++i) {
        const uint key = f2ui(load(row, i, false));
        if (key > threshold) {
            // the counts guarantee pos_gt < n_above; the test keeps a hypothetical
            // miscount inside this row instead of overwriting the next one
            if (pos_gt < n_above) {
                data_d[row_out + pos_gt] = int(i);
            }
            pos_gt++;
        } else if (key == threshold) {
            if (pos_eq < desired) {
                data_d[row_out + n_above + pos_eq] = int(i);
            }
            pos_eq++;
        }
    }
}

// [TAG_QSA_WHOLE_BLOCKS] (QSA == 2) ---------------------------------------------------------------
// The block-level form of the QSA selection (ggml_qsa_top_k_blocks; the contract and the CPU reference are in
// ggml.h / ggml-cpu ops.cpp). Per row: (1) radix-select the n_sel-th largest ELIGIBLE block key - the same
// passes as topk(), over the n_blocks block scores read straight from the score operand; (2) flag the selected
// blocks in the row's scratch (ties at the threshold to the lowest block indices, ranked like topk()'s emit);
// (3) one pass over the cells emits, in ascending id order, every tail cell and every visible cell of a flagged
// block; the rest of the row repeats the last id (0..k-1 when nothing is selected).

// block b of row (t, s): its (biased) score
float blk_score(uint row, uint b) {
    const uint t = row % p.n_tps;
    const uint s = row / p.n_tps;
    return data_a[s * p.n_blocks * p.n_tps + b * p.sb_blk + t * p.sb_tps];
}

// eligible = finite and below the tail boost. An eligible block's key is f2ui of its score (>= 0x00800000 for
// every finite value); every other block gets 0, below all of them, so a 0 threshold means "fewer than n_sel
// eligible blocks" and selects none of the ties.
uint blk_key(uint row, uint b) {
    const float a = blk_score(row, b);
    return (!isinf(a) && !isnan(a) && a < QSA_TAIL_MIN) ? f2ui(a) : 0u;
}

// cell i of row (t, s) is selected: a boosted (tail) cell, or a visible cell of a flagged block
bool cell_sel(uint row, uint i) {
    const uint  t = row % p.n_tps;
    const uint  s = row / p.n_tps;
    const uint  b = uint(cell_blk[s * p.ncols + i]);
    const float a = data_a[s * p.n_blocks * p.n_tps + b * p.sb_blk + t * p.sb_tps];
#ifdef QSA_VIS
    const float m = qsa_vis_mask(s, t, i);
#else
    const float m = float(mask[(s * p.n_tps + t) * p.ncols + i]);
#endif
    const float v = a + m;
    if (!isinf(v) && !isnan(v) && v >= QSA_TAIL_MIN) {
        return true;
    }
    return scratch[row * p.ncols + b] != 0.0 && !(isinf(m) && m < 0.0);
}

// inclusive scan of sh_gt and sh_eq over the workgroup (both share the barriers, as in topk())
void scan_counts() {
    const uint tid = gl_LocalInvocationID.x;
    for (uint d = 1; d < uint(BLOCK_SIZE); d <<= 1) {
        uint add_gt = 0;
        uint add_eq = 0;
        if (tid >= d) {
            add_gt = sh_gt[tid - d];
            add_eq = sh_eq[tid - d];
        }
        barrier();
        sh_gt[tid] += add_gt;
        sh_eq[tid] += add_eq;
        barrier();
    }
}

void topk_blocks(const uint row) {
    const uint tid     = gl_LocalInvocationID.x;
    const uint nb      = p.n_blocks;
    const uint ncols   = p.ncols;
    const uint row_out = row * p.k;
    const uint row_scr = row * ncols;      // the row's scratch: one flag per block (n_blocks <= n_kv)

    // (1) the n_want-th largest block key
    const uint n_want = min(p.n_sel, nb);
    uint prefix  = 0;
    uint desired = n_want;

    [[unroll]] for (int shift = 32 - RADIX_BITS; shift >= 0; shift -= RADIX_BITS) {
        for (uint i = tid; i < RADIX_SIZE; i += BLOCK_SIZE) {
            histo[i] = 0;
        }
        barrier();

        const uint hi_mask   = (shift + RADIX_BITS >= 32) ? 0u : (0xFFFFFFFFu << uint(shift + RADIX_BITS));
        const uint prefix_hi = prefix & hi_mask;
        for (uint b = tid; b < nb; b += BLOCK_SIZE) {
            const uint key = blk_key(row, b);
            if ((key & hi_mask) == prefix_hi) {
                atomicAdd(histo[(key >> uint(shift)) & (RADIX_SIZE - 1)], 1u);
            }
        }
        barrier();

        if (tid == 0) {
            uint acc = 0;
            uint bk  = 0;
            for (int bb = RADIX_SIZE - 1; bb >= 0; --bb) {
                const uint c = histo[bb];
                if (acc + c >= desired) { bk = uint(bb); break; }
                acc += c;
            }
            sh_bucket = bk;
            sh_above  = acc;
        }
        barrier();

        prefix  |= sh_bucket << uint(shift);
        desired -= sh_above;
        barrier();
    }

    // (2) flag the blocks: every key above the threshold, and the first `n_eq` ties by block index
    const uint thr  = prefix;
    const uint n_eq = thr != 0u ? desired : 0u;

    const uint qb  = nb / uint(BLOCK_SIZE);
    const uint rb  = nb % uint(BLOCK_SIZE);
    const uint blo = tid*qb + min(tid, rb);
    const uint bhi = blo + qb + (tid < rb ? 1u : 0u);

    uint cnt_eq = 0;
    for (uint b = blo; b < bhi; ++b) {
        cnt_eq += blk_key(row, b) == thr ? 1u : 0u;
    }
    sh_gt[tid] = 0;
    sh_eq[tid] = cnt_eq;
    barrier();
    scan_counts();

    uint pos_eq = tid == 0 ? 0 : sh_eq[tid - 1];
    for (uint b = blo; b < bhi; ++b) {
        const uint key = blk_key(row, b);
        bool sel = key > thr;
        if (key == thr) {
            sel = pos_eq < n_eq;
            pos_eq++;
        }
        scratch[row_scr + b] = sel ? 1.0 : 0.0;
    }

    // the flags are read below by other invocations than the ones that wrote them: publish
    // ([TAG_QSA_SCRATCH_COHERENT]; QSA is a specialization constant, so this is uniform control flow)
    controlBarrier(gl_ScopeWorkgroup, gl_ScopeWorkgroup, gl_StorageSemanticsBuffer, gl_SemanticsAcquireRelease);
    barrier();

    // (3) the cells, ascending: count per contiguous range, scan, emit
    const uint quot = ncols / uint(BLOCK_SIZE);
    const uint rem  = ncols % uint(BLOCK_SIZE);
    const uint lo   = tid*quot + min(tid, rem);
    const uint hi   = lo + quot + (tid < rem ? 1u : 0u);

    uint cnt  = 0;
    uint last = 0;
    for (uint i = lo; i < hi; ++i) {
        if (cell_sel(row, i)) {
            cnt++;
            last = i;
        }
    }
    sh_gt[tid] = cnt;
    sh_eq[tid] = 0;
    barrier();
    scan_counts();

    const uint total = sh_gt[BLOCK_SIZE - 1];
    uint pos = tid == 0 ? 0 : sh_gt[tid - 1];

    // the range holding the row's last selected cell (the largest id) publishes it
    if (cnt > 0 && sh_gt[tid] == total) {
        sh_last = last;
    }

    for (uint i = lo; i < hi && pos < p.k; ++i) {
        if (cell_sel(row, i)) {
            data_d[row_out + pos] = int(i);
            pos++;
        }
    }
    barrier();

    // padding: a repeat of the last id written (= the largest selected id when total <= k), or 0..k-1
    const uint c = min(total, p.k);
    for (uint j = c + tid; j < p.k; j += BLOCK_SIZE) {
        data_d[row_out + j] = total > 0 ? int(sh_last) : int(j);
    }
    barrier();
}

void main() {
    for (uint row = gl_WorkGroupID.y; row < p.nrows; row += gl_NumWorkGroups.y) {
        if (QSA == 2) {
            topk_blocks(row);
        } else {
            topk(row);
        }
    }
}
