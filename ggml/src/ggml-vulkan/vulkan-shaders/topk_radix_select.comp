#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require

#include "types.glsl"

layout(constant_id = 0) const int BLOCK_SIZE = 1024;
layout(constant_id = 1) const int QSA = 0; // 1: fuse the qwen4 QSA indexer gather + f16 mask

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A  {float     data_a[];};   // input values, or QSA block scores [n_tps, n_blocks, n_stream]
layout (binding = 1) writeonly buffer D {int       data_d[];};   // [k, ...]
layout (binding = 2) readonly buffer CB {int       cell_blk[];}; // QSA: cell->block map [n_kv, n_stream]
layout (binding = 3) readonly buffer M  {float16_t mask[];};     // QSA: raw f16 kq_mask [n_kv, n_tps, n_stream]
layout (binding = 4) buffer S           {float     scratch[];};  // QSA: [nrows, n_kv] gathered inputs

layout (push_constant) uniform parameter {
    uint ncols;
    uint k;
    uint nrows;
    uint n_tps;    // QSA only
    uint n_blocks; // QSA only
    uint n_stream; // QSA only
} p;

#define RADIX_BITS 8
#define RADIX_SIZE (1 << RADIX_BITS)

shared uint histo[RADIX_SIZE];
shared uint sh_bucket;
shared uint sh_above;
// per-invocation counts of the two output classes, scanned in place (see topk)
shared uint sh_gt[BLOCK_SIZE];
shared uint sh_eq[BLOCK_SIZE];

// order-preserving float -> uint mapping. -0.0 is folded onto +0.0 first: its bit pattern
// sorts strictly below +0.0, but IEEE compare - and therefore the CPU reference - calls the
// two equal, and now that ties are resolved by index the difference is observable in the
// selected SET whenever the threshold value is zero.
uint f2ui(float x) {
    uint y = floatBitsToUint(x);
    if (y == 0x80000000u) {
        y = 0u;
    }
    if ((y & 0x80000000u) != 0u) {
        y ^= 0xFFFFFFFFu;
    } else {
        y |= 0x80000000u;
    }
    return y;
}

// QSA element i of row (t,s): score[cell_blk[i,s], t, s] + mask[i,t,s]
float gather(uint row, uint i) {
    const uint t = row % p.n_tps;
    const uint s = row / p.n_tps;
    const uint block = uint(cell_blk[s * p.ncols + i]);
    const float a = data_a[(s * p.n_blocks + block) * p.n_tps + t];
    const float m = float(mask[(s * p.n_tps + t) * p.ncols + i]);
    return a + m;
}

float load(uint row, uint i, bool first) {
    if (QSA == 0) {
        return data_a[row * p.ncols + i];
    }
    // materialize the scattered gather on the first pass and reuse it after. The radix
    // passes keep the same strided element->invocation map as the pass that wrote it, so
    // they read their own entries; the emit phase below re-partitions the row and must
    // publish the writes first (memoryBarrierBuffer).
    const uint off = row * p.ncols + i;
    if (first) {
        const float v = gather(row, i);
        scratch[off] = v;
        return v;
    }
    return scratch[off];
}

// one workgroup per row: radix-select the K-th largest, then compact it plus the lowest-index ties
void topk(const uint row) {
    const uint tid = gl_LocalInvocationID.x;
    const uint ncols = p.ncols;
    const uint row_out = row * p.k;

    uint prefix  = 0;     // fixed high bits of the threshold key
    uint desired = p.k;   // count still needed from the candidate range

    [[unroll]] for (int shift = 32 - RADIX_BITS; shift >= 0; shift -= RADIX_BITS) {
        for (uint i = tid; i < RADIX_SIZE; i += BLOCK_SIZE) {
            histo[i] = 0;
        }
        barrier();

        const bool first     = (shift == 32 - RADIX_BITS);
        const uint hi_mask   = (shift + RADIX_BITS >= 32) ? 0u : (0xFFFFFFFFu << uint(shift + RADIX_BITS));
        const uint prefix_hi = prefix & hi_mask;
        for (uint i = tid; i < ncols; i += BLOCK_SIZE) {
            const uint key = f2ui(load(row, i, first));
            if ((key & hi_mask) == prefix_hi) {
                atomicAdd(histo[(key >> uint(shift)) & (RADIX_SIZE - 1)], 1u);
            }
        }
        barrier();

        // top-down scan for the bucket holding the K-th value
        if (tid == 0) {
            uint acc = 0;
            uint b   = 0;
            for (int bb = RADIX_SIZE - 1; bb >= 0; --bb) {
                const uint c = histo[bb];
                if (acc + c >= desired) { b = uint(bb); break; }
                acc += c;
            }
            sh_bucket = b;
            sh_above  = acc;
        }
        barrier();

        prefix  |= sh_bucket << uint(shift);
        desired -= sh_above;
        barrier();
    }

    // Emit. `threshold` is the key of the k-th largest element and `desired` is how many of
    // the elements EQUAL to it the row still needs, so `k - desired` elements are strictly
    // above it and all of them are selected. Which ties fill the rest is a real choice: pick
    // the lowest indices, which is what the CPU reference selects (it sorts by value
    // descending, index ascending), so the two agree element for element.
    //
    // The rank of an element within its class is computed instead of raced for: the row is
    // split into BLOCK_SIZE contiguous ranges, one per invocation, and a prefix sum over the
    // per-range counts turns "how many of my class come before my range" into "where my range
    // starts". Both classes share the scan's barriers. Nothing here is order-dependent, so
    // the ids are a pure function of the input - including their order, which the QSA gather
    // path needs: it sums the attention window in id order.
    const uint threshold = prefix;
    const uint n_above   = p.k - desired;

    // contiguous ranges, balanced to +-1 element; tid*quot cannot overflow (it is <= ncols)
    const uint quot = ncols / uint(BLOCK_SIZE);
    const uint rem  = ncols % uint(BLOCK_SIZE);
    const uint lo   = tid*quot + min(tid, rem);
    const uint hi   = lo + quot + (tid < rem ? 1u : 0u);

    if (QSA != 0) {
        // the ranges cross the strided map the radix passes used, so this is the first read
        // of scratch entries another invocation wrote - publish them
        memoryBarrierBuffer();
    }
    barrier();

    uint cnt_gt = 0;
    uint cnt_eq = 0;
    for (uint i = lo; i < hi; ++i) {
        const uint key = f2ui(load(row, i, false));
        cnt_gt += key >  threshold ? 1u : 0u;
        cnt_eq += key == threshold ? 1u : 0u;
    }
    sh_gt[tid] = cnt_gt;
    sh_eq[tid] = cnt_eq;
    barrier();

    for (uint d = 1; d < uint(BLOCK_SIZE); d <<= 1) {
        uint add_gt = 0;
        uint add_eq = 0;
        if (tid >= d) {
            add_gt = sh_gt[tid - d];
            add_eq = sh_eq[tid - d];
        }
        barrier();
        sh_gt[tid] += add_gt;
        sh_eq[tid] += add_eq;
        barrier();
    }

    // exclusive prefix: where this range's first element of each class lands
    uint pos_gt = tid == 0 ? 0 : sh_gt[tid - 1];
    uint pos_eq = tid == 0 ? 0 : sh_eq[tid - 1];

    for (uint i = lo; i < hi; ++i) {
        const uint key = f2ui(load(row, i, false));
        if (key > threshold) {
            // the counts guarantee pos_gt < n_above; the test keeps a hypothetical
            // miscount inside this row instead of overwriting the next one
            if (pos_gt < n_above) {
                data_d[row_out + pos_gt] = int(i);
            }
            pos_gt++;
        } else if (key == threshold) {
            if (pos_eq < desired) {
                data_d[row_out + n_above + pos_eq] = int(i);
            }
            pos_eq++;
        }
    }
}

void main() {
    for (uint row = gl_WorkGroupID.y; row < p.nrows; row += gl_NumWorkGroups.y) {
        topk(row);
    }
}
